---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Update Password // PostPulsar">
  <main
    class="container flex min-h-[calc(100vh-80px)] flex-col items-center justify-center"
  >
    <div class="w-full max-w-md border border-border p-8">
      <h2 class="mb-6 text-center text-2xl font-bold uppercase">
        // Create New Password
      </h2>

      <form id="update-password-form" class="space-y-6">
        <div>
          <label
            for="new-password"
            class="mb-2 block font-mono text-xs font-bold uppercase tracking-widest text-foreground/70"
            >New Password</label
          >
          <input
            id="new-password"
            name="new-password"
            type="password"
            required
            class="w-full rounded-none border border-border bg-background p-3 font-mono focus:border-primary focus:outline-none focus:ring-0"
            placeholder="::INPUT_SECRET::"
          />
        </div>
        <div>
          <label
            for="confirm-password"
            class="mb-2 block font-mono text-xs font-bold uppercase tracking-widest text-foreground/70"
            >Confirm New Password</label
          >
          <input
            id="confirm-password"
            name="confirm-password"
            type="password"
            required
            class="w-full rounded-none border border-border bg-background p-3 font-mono focus:border-primary focus:outline-none focus:ring-0"
            placeholder="::INPUT_SECRET::"
          />
        </div>

        <button
          type="submit"
          class="w-full border border-primary bg-primary p-3 font-mono text-sm font-bold uppercase text-background transition-colors hover:bg-primary/80"
          >Update Password &gt;&gt;</button
        >
      </form>
      <div id="message" class="mt-4 text-sm"></div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from "../lib/supabase";

  const form = document.getElementById("update-password-form");
  const messageEl = document.getElementById("message");

  // On page load, Supabase client checks for a recovery token in the URL.
  // If one is present, it sets it in local storage.
  // The updateUser call below will then use this token automatically.

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const newPassword = (document.getElementById("new-password") as HTMLInputElement).value;
    const confirmPassword = (document.getElementById("confirm-password") as HTMLInputElement).value;
    messageEl.textContent = "";

    if (newPassword.length < 6) {
      messageEl.textContent = "[ERROR] :: Password must be at least 6 characters.";
      messageEl.className = "font-mono text-red-500";
      return;
    }
    if (newPassword !== confirmPassword) {
      messageEl.textContent = "[ERROR] :: Passwords do not match.";
      messageEl.className = "font-mono text-red-500";
      return;
    }

    const { error } = await supabase.auth.updateUser({ password: newPassword });

    if (error) {
      messageEl.textContent = `[ERROR] :: ${error.message}`;
      messageEl.className = "font-mono text-red-500";
    } else {
      messageEl.textContent = "[SUCCESS] :: Password updated. You can now log in.";
      messageEl.className = "font-mono text-green-500";
      form.reset();
      setTimeout(() => (window.location.href = "/login"), 2000);
    }
  });
</script>
