---

---

<header class="sticky top-0 z-50 bg-background/80 backdrop-blur-sm">
  <nav
    class="container flex min-h-[80px] items-center justify-between border-b border-border px-6 py-4"
  >
    <a href="/" class="text-xl font-bold uppercase tracking-wider">
      P<span class="text-primary">[</span>O<span class="text-primary">]</span
      >STPULSAR
    </a>

    <!-- Hamburger Button -->
    <div class="md:hidden">
      <button
        id="menu-btn"
        type="button"
        class="z-50 block text-primary focus:outline-none"
      >
        <svg
          id="menu-icon-open"
          class="size-6"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M4 6H20M4 12H20M4 18H20"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <svg
          id="menu-icon-close"
          class="hidden size-6"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M6 18L18 6M6 6l12 12"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>

    <div
      id="nav-links"
      class="hidden text-sm font-medium uppercase text-primary md:flex md:items-center md:space-x-6"
    >
      <a href="/blog" class="transition-colors hover:text-primary/80">
        /BLOG
      </a>

      <!-- Dashboard Dropdown -->
      <div class="group relative auth-hidden" data-auth="true">
        <a
          href="/app"
          class="flex items-center transition-colors hover:text-primary/80"
        >
          /DASHBOARD
          <svg
            class="ml-1 h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </a>
        <div
          class="invisible absolute left-0 top-full pt-2 w-48 rounded-md border border-border bg-background py-1 opacity-0 transition-opacity duration-200 group-hover:visible group-hover:opacity-100"
        >
          <a
            href="/app/insights"
            class="block px-4 py-2 text-sm text-primary transition-colors hover:bg-primary/10"
            >/INSIGHTS</a
          >
        </div>
      </div>

      <a
        href="/app/connections"
        class="auth-hidden text-primary transition-colors hover:text-primary/80"
        data-auth="true"
      >
        /CONNECTIONS
      </a>
      <a
        href="/app/history"
        class="auth-hidden text-primary transition-colors hover:text-primary/80"
        data-auth="true"
      >
        /HISTORY
      </a>
      <a
        href="/app/settings"
        class="auth-hidden text-primary transition-colors hover:text-primary/80"
        data-auth="true"
      >
        /SETTINGS
      </a>
      <a
        href="/app/billing"
        class="auth-hidden text-primary transition-colors hover:text-primary/80"
        data-auth="true"
      >
        /BILLING
      </a>
      <a href="/affiliates" class="transition-colors hover:text-primary/80">
        /AFFILIATES
      </a>
      <a
        href="/login"
        class="auth-hidden text-primary transition-colors hover:text-primary/80"
        data-auth="false"
      >
        /LOGIN
      </a>
      <a
        href="/signup"
        class="auth-hidden mt-4 block border border-primary bg-primary px-4 py-2 text-background transition-colors hover:bg-primary/80 md:mt-0 md:inline-block"
        data-auth="false"
      >
        ACTIVATE ACCOUNT
      </a>
      <button
        id="logout-btn-header"
        class="auth-hidden mt-4 block w-full border border-primary px-4 py-2 text-left text-primary transition-colors hover:bg-primary/10 md:mt-0 md:inline-block"
        data-auth="true"
      >
        LOGOUT
      </button>
    </div>
  </nav>
</header>

<style>
  .mobile-menu {
    position: absolute;
    top: 80px; /* Adjust to header height */
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(
      10,
      10,
      10,
      0.98
    ); /* background with slight transparency */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: calc(100vh - 80px);
  }
  .mobile-menu a,
  .mobile-menu button {
    display: block;
    padding: 1rem;
    font-size: 1.25rem;
    width: 100%;
    text-align: center;
  }
</style>

<script>
  const menuBtn = document.getElementById("menu-btn");
  const navLinks = document.getElementById("nav-links");
  const menuIconOpen = document.getElementById("menu-icon-open");
  const menuIconClose = document.getElementById("menu-icon-close");

  if (menuBtn && navLinks && menuIconOpen && menuIconClose) {
    menuBtn.addEventListener("click", () => {
      navLinks.classList.toggle("hidden");
      navLinks.classList.toggle("mobile-menu");
      menuIconOpen.classList.toggle("hidden");
      menuIconClose.classList.toggle("hidden");
    });
  }
</script>
