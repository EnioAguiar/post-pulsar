---

---

<header class="bg-gray-900 text-white shadow-lg">
  <nav class="container mx-auto flex items-center justify-between px-6 py-4">
    <a
      href="/"
      class="text-2xl font-bold transition-colors duration-300 hover:text-gray-300"
      >PostPulsar</a
    >
    <div id="nav-links" class="hidden items-center space-x-6 md:flex">
      <a
        href="/app"
        class="transition-colors duration-300 hover:text-gray-300"
        data-auth="true"
        style="display: none;">Dashboard</a
      >
      <a
        href="/login"
        class="transition-colors duration-300 hover:text-gray-300"
        data-auth="false"
        style="display: none;">Login</a
      >
      <a
        href="/signup"
        class="rounded-lg bg-blue-600 px-4 py-2 font-bold text-white transition-transform hover:scale-105 hover:bg-blue-700"
        data-auth="false"
        style="display: none;">Sign Up</a
      >
      <button
        id="logout-btn-header"
        class="rounded-lg bg-red-600 px-4 py-2 font-bold text-white transition-transform hover:scale-105 hover:bg-red-700"
        data-auth="true"
        style="display: none;">Logout</button
      >
    </div>
  </nav>
</header>
