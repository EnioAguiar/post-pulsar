---

---

<header class="sticky top-0 z-50 bg-background/80 backdrop-blur-sm">
  <nav
    class="container flex min-h-[80px] items-center justify-between border-b border-border px-6 py-4"
  >
    <a href="/" class="text-xl font-bold uppercase tracking-wider">
      P<span class="text-primary">[</span>O<span class="text-primary">]</span
      >STPULSAR
    </a>

    <!-- Hamburger Button -->
    <div class="md:hidden">
      <button
        id="menu-btn"
        type="button"
        class="z-50 block text-primary focus:outline-none"
      >
        <svg
          id="menu-icon-open"
          class="size-6"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M4 6H20M4 12H20M4 18H20"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <svg
          id="menu-icon-close"
          class="hidden size-6"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M6 18L18 6M6 6l12 12"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>

    <div
      id="nav-links"
      class="hidden text-sm font-medium uppercase md:flex md:items-center md:space-x-6"
    >
      <a href="/blog" class="transition-colors hover:text-primary"> /BLOG </a>
      <a
        href="https://www.producthunt.com/posts/postpulsar?utm_source=badge-featured&utm_medium=badge&utm_souce=badge-postpulsar"
        target="_blank"
        class="auth-hidden flex items-center rounded-md border border-primary px-3 py-1.5 text-sm font-bold text-primary transition-colors hover:bg-primary/10"
        data-auth="false"
      >
        <svg
          class="mr-2 size-5"
          viewBox="0 0 24 24"
          role="img"
          xmlns="http://www.w3.org/2000/svg"
          fill="currentColor"
        >
          <title>Product Hunt icon</title><path
            d="M13.604 8.4h-3.405V12h3.405c.995 0 1.801-.806 1.801-1.801 0-.993-.805-1.799-1.801-1.799zM12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zm1.604 14.4h-3.405V18H7.801V6h5.804c2.319 0 4.2 1.88 4.2 4.199 0 2.321-1.881 4.201-4.201 4.201z"
          ></path></svg
        >
        PRODUCT HUNT
      </a>
      <a
        href="/app"
        class="auth-hidden transition-colors hover:text-primary"
        data-auth="true"
      >
        /DASHBOARD
      </a>
      <a
        href="/app/connections"
        class="auth-hidden transition-colors hover:text-primary"
        data-auth="true"
      >
        /CONNECTIONS
      </a>
      <a
        href="/app/history"
        class="auth-hidden transition-colors hover:text-primary"
        data-auth="true"
      >
        /HISTORY
      </a>
      <a
        href="/app/settings"
        class="auth-hidden transition-colors hover:text-primary"
        data-auth="true"
      >
        /SETTINGS
      </a>
      <a
        href="/app/billing"
        class="auth-hidden transition-colors hover:text-primary"
        data-auth="true"
      >
        /BILLING
      </a>
      <a
        href="/app/affiliates"
        class="auth-hidden transition-colors hover:text-primary"
        data-auth="true"
      >
        /AFFILIATES
      </a>
      <a
        href="/login"
        class="auth-hidden transition-colors hover:text-primary"
        data-auth="false"
      >
        /LOGIN
      </a>
      <a
        href="/signup"
        class="auth-hidden mt-4 block border border-primary bg-primary px-4 py-2 text-background transition-colors hover:bg-primary/80 md:mt-0 md:inline-block"
        data-auth="false"
      >
        ACTIVATE ACCOUNT
      </a>
      <button
        id="logout-btn-header"
        class="auth-hidden mt-4 block w-full border border-primary px-4 py-2 text-left text-primary transition-colors hover:bg-primary/10 md:mt-0 md:inline-block"
        data-auth="true"
      >
        LOGOUT
      </button>
    </div>
  </nav>
</header>

<style>
  .mobile-menu {
    position: absolute;
    top: 80px; /* Adjust to header height */
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(
      10,
      10,
      10,
      0.98
    ); /* background with slight transparency */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: calc(100vh - 80px);
  }
  .mobile-menu a,
  .mobile-menu button {
    display: block;
    padding: 1rem;
    font-size: 1.25rem;
    width: 100%;
    text-align: center;
  }
</style>

<script>
  const menuBtn = document.getElementById("menu-btn");
  const navLinks = document.getElementById("nav-links");
  const menuIconOpen = document.getElementById("menu-icon-open");
  const menuIconClose = document.getElementById("menu-icon-close");

  if (menuBtn && navLinks && menuIconOpen && menuIconClose) {
    menuBtn.addEventListener("click", () => {
      navLinks.classList.toggle("hidden");
      navLinks.classList.toggle("mobile-menu");
      menuIconOpen.classList.toggle("hidden");
      menuIconClose.classList.toggle("hidden");
    });
  }
</script>
