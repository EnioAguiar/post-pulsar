---
// Conteúdo da seção "Pricing"
---
<section class="py-20">
  <div class="text-center">
    <h2 class="text-4xl font-bold uppercase">Pricing</h2>
    <p class="mt-2 text-lg text-foreground/70">
      Start for free, upgrade when you need more power.
    </p>
  </div>
  <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
    <!-- Free Plan -->
    <div class="flex flex-col rounded-lg border-2 border-primary p-8">
      <h3 class="text-2xl font-bold">Free</h3>
      <p class="mt-4 text-5xl font-bold">
        $0<span class="text-lg font-normal text-foreground/70">/month</span>
      </p>
      <p class="mt-4 text-foreground/70">
        Perfect for getting started and trying out the platform.
      </p>
      <ul class="mt-6 flex-grow space-y-2">
        <li class="flex items-center">
          <svg
            class="mr-2 h-5 w-5 text-primary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          70 Pulses/month
        </li>
        <li class="flex items-center">
          <svg
            class="mr-2 h-5 w-5 text-primary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          Text-only publishing
        </li>
        <li class="flex items-center">
          <svg
            class="mr-2 h-5 w-5 text-primary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          Image publishing for Instagram
        </li>
      </ul>
      <a
        href="/signup"
        class="mt-8 block w-full rounded-md border border-primary bg-primary px-8 py-3 text-center font-mono text-sm font-bold uppercase text-background transition-colors hover:bg-primary/80"
        >Start for Free</a
      >
    </div>

    <!-- Classic Plan -->
    <div class="flex flex-col rounded-lg border border-border bg-background/30 p-8">
      <h3 class="text-2xl font-bold">Classic</h3>
      <p class="mt-4 text-5xl font-bold">
        $9<span class="text-lg font-normal text-foreground/70">/30 days</span>
      </p>
      <p class="mt-4 text-foreground/70">
        For creators who need more volume and image support.
      </p>
      <ul class="mt-6 flex-grow space-y-2">
        <li class="flex items-center">
          <svg
            class="mr-2 h-5 w-5 text-primary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          210 Pulses
        </li>
        <li class="flex items-center">
          <svg
            class="mr-2 h-5 w-5 text-primary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          Text & Image publishing
        </li>
      </ul>
      <a
        href="/signup"
        class="mt-8 block w-full rounded-md border border-primary px-8 py-3 text-center font-mono text-sm font-bold uppercase text-primary transition-colors hover:bg-primary hover:text-background"
        data-auth="false"
        >Choose Classic</a
      >
      <a
        href="/app/billing?plan=classic"
        class="auth-hidden mt-8 block w-full rounded-md border border-border px-8 py-3 text-center font-mono text-sm font-bold uppercase text-primary transition-colors hover:bg-primary hover:text-background"
        data-auth="true"
        >Choose Classic</a
      >
    </div>

    <!-- Pro Plan -->
    <div class="flex flex-col rounded-lg border border-border bg-background/30 p-8">
      <h3 class="text-2xl font-bold">Pro</h3>
      <p class="mt-4 text-5xl font-bold">
        $29<span class="text-lg font-normal text-foreground/70">/30 days</span>
      </p>
      <p class="mt-4 text-foreground/70">
        The ultimate toolkit with video support and maximum pulses.
      </p>
      <ul class="mt-6 flex-grow space-y-2">
        <li class="flex items-center">
          <svg
            class="mr-2 h-5 w-5 text-primary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          500 Pulses
        </li>
        <li class="flex items-center">
          <svg
            class="mr-2 h-5 w-5 text-primary"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path></svg
          >
          Text, Image & Video publishing
        </li>
      </ul>
      <a
        href="/signup"
        class="mt-8 block w-full rounded-md border border-primary px-8 py-3 text-center font-mono text-sm font-bold uppercase text-primary transition-colors hover:bg-primary hover:text-background"
        data-auth="false"
        >Choose Pro</a
      >
      <a
        href="/app/billing?plan=pro"
        class="auth-hidden mt-8 block w-full rounded-md border border-border px-8 py-3 text-center font-mono text-sm font-bold uppercase text-primary transition-colors hover:bg-primary hover:text-background"
        data-auth="true"
        >Choose Pro</a
      >
    </div>
  </div>
  <div class="mt-12 text-center">
    <h3 class="text-2xl font-bold uppercase">Need More?</h3>
    <p class="mt-2 text-lg text-foreground/70">
      You can purchase extra pulse packs at any time.
    </p>
    <div class="mt-4 inline-flex flex-wrap justify-center gap-4 font-mono">
      <span class="rounded-md border border-border bg-background/50 px-4 py-2">100 Pulses for $5</span>
      <span class="rounded-md border border-border bg-background/50 px-4 py-2">250 Pulses for $10</span>
      <span class="rounded-md border border-border bg-background/50 px-4 py-2">600 Pulses for $20</span>
    </div>
  </div>
</section>
