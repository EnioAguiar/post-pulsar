<script>
  import { supabase } from "../../lib/supabase";

  // Helper to format money based on currency
  function formatCurrency(amount, currency) {
    const amountInMajorUnits = amount / 100;
    return new Intl.NumberFormat(undefined, {
      style: "currency",
      currency: currency,
    }).format(amountInMajorUnits);
  }

  async function fetchAndDisplayRegionalPrices() {
    const priceElements = document.querySelectorAll("[data-price-id]");
    const initialTexts = new Map();
    priceElements.forEach((el) => {
      initialTexts.set(el, el.innerHTML);
      const span = el.querySelector("span");
      if (span) {
        el.innerHTML = `... ${span.outerHTML}`;
      } else {
        el.innerHTML = "...";
      }
    });

    try {
      const { data: prices, error } = await supabase.functions.invoke(
        "get-regional-prices",
      );

      if (error) throw error;
      if (!prices) throw new Error("No prices returned");

      priceElements.forEach((el) => {
        const element = el as HTMLElement;
        const productId = element.dataset.priceId;

        if (prices[productId]) {
          const priceData = prices[productId];
          const { amount, currency } = priceData;
          const formattedPrice = formatCurrency(amount, currency);

          if (productId.startsWith("plan_")) {
            const span = element.querySelector("span");
            if (span) {
              element.innerHTML = `${formattedPrice}${span.outerHTML}`;
            }
          } else {
            // For pulse packs, update the whole text
            const pulseAmount = productId.split("_")[2];
            element.textContent = `${pulseAmount} Pulses for ${formattedPrice}`;
          }
        }
      });
    } catch (e) {
      console.error(
        "Could not fetch regional prices. Reverting to default prices.",
        e.message,
      );
      // Revert to initial texts on error
      priceElements.forEach((el) => {
        if (initialTexts.has(el)) {
          el.innerHTML = initialTexts.get(el);
        }
      });
    }
  }

  document.addEventListener("DOMContentLoaded", fetchAndDisplayRegionalPrices);
</script>
