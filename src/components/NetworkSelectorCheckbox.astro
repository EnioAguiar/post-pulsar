---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<label
  class="flex items-center gap-2 rounded-none border border-border bg-background p-4 font-mono text-lg"
>
  <input
    type="checkbox"
    name="target-network"
    value={value}
    class="network-select-checkbox size-5 rounded-none bg-background accent-primary focus:ring-0 focus:ring-offset-0"
  />
  <span>{label}</span>
</label>
