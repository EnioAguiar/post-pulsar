---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "PostPulsar Pro Plan - Ultimate AI Content Repurposing";
---
<style>
  .custom-button {
    background-color: #ff4500;
    color: #ffffff;
    padding: 1rem 2rem;
    border-radius: 0.25rem;
    font-weight: bold;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-block;
  }
  .custom-button:hover {
    background-color: #e63e00;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(255, 69, 0, 0.4);
  }
</style>

<Layout title={pageTitle} hideHeader={true}>
  
  <main class="flex flex-col items-center justify-center min-h-screen bg-[#0a0a0a] text-[#e0e0e0] p-4 sm:p-8 font-[IBM Plex Mono]">
    <div class="max-w-4xl text-center">
      
      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold mb-4 leading-tight uppercase">
        Stop Wasting Hours Repurposing Content
      </h1>
      <p class="text-xl sm:text-2xl text-[#ff4500] mb-8">
        Turn <span class="font-bold">One</span> Blog Post into a <span class="font-bold">Full Social Media Campaign</span> with AI.
      </p>
      
      <!-- Problem -->
      <p class="text-lg text-gray-300 mb-12 max-w-2xl mx-auto">
        Tired of the endless copy-pasting, reformatting, and brainstorming to adapt your content for every social network? You write one great article, but turning it into engaging posts for Twitter, LinkedIn, and Instagram feels like a full-time job. It's time to automate the grunt work.
      </p>

      <!-- Solution -->
      <div class="bg-gray-800/20 p-6 sm:p-8 rounded-xl border border-[#ff4500]/30 mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4 uppercase">Introducing: PostPulsar Pro Plan</h2>
        <p class="text-lg text-gray-200">
          Your AI-Powered Content Repurposing Engine. We give you the power to multiply your content, maximize your reach, and reclaim your time.
        </p>
      </div>

      <section id="features" class="mb-12">
        <div class="text-center">
          <h2 class="text-4xl font-bold uppercase">
            Explore the PostPulsar Features
          </h2>
          <p class="mt-2 text-lg text-gray-300">
            A quick look at the powerful features available.
          </p>
        </div>
        <div id="features-accordion" class="mx-auto mt-12 max-w-3xl space-y-4 text-left">
          <details class="group rounded-lg border border-gray-700/50 p-6">
            <summary
              class="flex cursor-pointer list-none items-center justify-between text-xl font-semibold text-[#e0e0e0] transition-colors hover:text-[#ff4500]"
            >
              <span>Mission Control & Advanced Settings</span>
              <span class="text-[#ff4500] transition-transform group-open:rotate-180">
                <svg
                  class="size-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path></svg
                >
              </span>
            </summary>
            <div class="mt-4">
              <p class="mb-4 text-gray-300">
                Your central dashboard for content generation. Paste your URL, select
                networks, and dive into advanced settings to customize character
                limits and fine-tune AI prompts.
              </p>
              <img
                src="/Mission%20Control%20&%20Advanced%20Settings.jpg"
                alt="PostPulsar Dashboard"
                class="feature-image cursor-pointer rounded-md border border-gray-700"
              />
            </div>
          </details>
      
          <details class="group rounded-lg border border-gray-700/50 p-6">
            <summary
              class="flex cursor-pointer list-none items-center justify-between text-xl font-semibold text-[#e0e0e0] transition-colors hover:text-[#ff4500]"
            >
              <span>AI-Powered Content Generation</span>
              <span class="text-[#ff4500] transition-transform group-open:rotate-180">
                <svg
                  class="size-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path></svg
                >
              </span>
            </summary>
            <div class="mt-4">
              <p class="mb-4 text-gray-300">
                Watch as our AI transforms your source material into a variety of
                ready-to-publish posts, perfectly tailored for each social network's
                style and format.
              </p>
              <img
                src="/AI-Powered%20Content%20Generation.jpg"
                alt="AI-Generated Content"
                class="feature-image cursor-pointer rounded-md border border-gray-700"
              />
            </div>
          </details>
      
          <details class="group rounded-lg border border-gray-700/50 p-6">
            <summary
              class="flex cursor-pointer list-none items-center justify-between text-xl font-semibold text-[#e0e0e0] transition-colors hover:text-[#ff4500]"
            >
              <span>AI Quote Image Generation with Templates</span>
              <span class="text-[#ff4500] transition-transform group-open:rotate-180">
                <svg
                  class="size-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path></svg
                >
              </span>
            </summary>
            <div class="mt-4">
              <p class="mb-4 text-gray-300">
                Turn impactful quotes from your content into stunning, shareable
                images. Choose from diverse templates and customize colors to match
                your brand. Available features depend on your plan.
              </p>
              <img
                src="/AI%20Quote%20Image%20Generation%20with%20Templates.jpg"
                alt="AI Quote Image Generation"
                class="feature-image cursor-pointer rounded-md border border-gray-700"
              />
            </div>
          </details>
      
          <details class="group rounded-lg border border-gray-700/50 p-6">
            <summary
              class="flex cursor-pointer list-none items-center justify-between text-xl font-semibold text-[#e0e0e0] transition-colors hover:text-[#ff4500]"
            >
              <span>Review and Refine Every Post</span>
              <span class="text-[#ff4500] transition-transform group-open:rotate-180">
                <svg
                  class="size-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path></svg
                >
              </span>
            </summary>
            <div class="mt-4">
              <p class="mb-4 text-gray-300">
                You have full control. Edit the generated text, add media like images
                and videos, and fine-tune every detail before it goes live.
              </p>
              <img
                src="/facebookpost.jpg"
                alt="Editing a post"
                class="feature-image cursor-pointer rounded-md border border-gray-700"
              />
            </div>
          </details>
      
          <details class="group rounded-lg border border-gray-700/50 p-6">
            <summary
              class="flex cursor-pointer list-none items-center justify-between text-xl font-semibold text-[#e0e0e0] transition-colors hover:text-[#ff4500]"
            >
              <span>Keep Track of Your Content</span>
              <span class="text-[#ff4500] transition-transform group-open:rotate-180">
                <svg
                  class="size-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path></svg
                >
              </span>
            </summary>
            <div class="mt-4">
              <p class="mb-4 text-gray-300">
                Every post you publish is saved to your history. Easily review past
                content or even reopen it in the dashboard for repurposing.
              </p>
              <img
                src="/Keep%20Track%20of%20Your%20Content.jpg"
                alt="Post History Page"
                class="feature-image cursor-pointer rounded-md border border-gray-700"
              />
            </div>
          </details>
      
          <details class="group rounded-lg border border-gray-700/50 p-6">
            <summary
              class="flex cursor-pointer list-none items-center justify-between text-xl font-semibold text-[#e0e0e0] transition-colors hover:text-[#ff4500]"
            >
              <span>Connect Your Social Networks</span>
              <span class="text-[#ff4500] transition-transform group-open:rotate-180">
                <svg
                  class="size-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path></svg
                >
              </span>
            </summary>
            <div class="mt-4">
              <p class="mb-4 text-gray-300">
                Connect all your accounts like LinkedIn, Twitter, and Instagram for
                seamless, one-click publishing.
              </p>
              <img
                src="/Available%20Networks.jpg"
                alt="Available Networks"
                class="feature-image cursor-pointer rounded-md border border-gray-700"
              />
            </div>
          </details>
      
          <details class="group rounded-lg border border-gray-700/50 p-6">
            <summary
              class="flex cursor-pointer list-none items-center justify-between text-xl font-semibold text-[#e0e0e0] transition-colors hover:text-[#ff4500]"
            >
              <span>Seamless App Integrations</span>
              <span class="text-[#ff4500] transition-transform group-open:rotate-180">
                <svg
                  class="size-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"></path></svg
                >
              </span>
            </summary>
            <div class="mt-4">
              <p class="mb-4 text-gray-300">
                Connect directly to apps like Discord and Telegram using webhooks and
                bot tokens for direct publishing to your communities.
              </p>
              <img
                src="/App%20Integrations.jpg"
                alt="App Integrations Page"
                class="feature-image cursor-pointer rounded-md border border-gray-700"
              />
            </div>
          </details>
        </div>
      </section>

      <!-- Call to Action -->
      <div class="mb-12">
        <h2 class="text-3xl font-semibold mb-6 uppercase">Get Instant Access to the PostPulsar Pro Plan!</h2>
        
        <p class="text-gray-400 mb-6">One-Time Payment for 30 Days of Pro Access</p>

        <!-- JVZoo Buy Button -->
        <a href="https://www.jvzoo.com/b/115075/429463/3" class="mx-auto inline-block">
          <img src="https://i.jvzoo.com/115075/429463/3" alt="PostPulsar" border="0" />
        </a>
      </div>

      <!-- Footer -->
      <footer class="mt-12 text-gray-400 text-sm">
        <p class="mb-4">For support and contact, please email <a href="mailto:support@postpulsar.com" class="text-[#ff4500] hover:underline">support@postpulsar.com</a>.</p>
        <p>&copy; {new Date().getFullYear()} PostPulsar. All rights reserved.</p>
      </footer>
    </div>
  </main>
</Layout>
