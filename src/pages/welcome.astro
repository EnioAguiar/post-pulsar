---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Welcome to PostPulsar!">
  <main class="container mx-auto px-4 py-20 text-center">
    <h1 class="text-4xl font-bold uppercase text-primary">
      Thank You for Signing Up!
    </h1>
    <p
      id="welcome-message"
      class="mx-auto mt-4 max-w-2xl text-lg text-foreground/70"
    >
      Your account has been created. Please check your email to verify your
      account and get started.
    </p>
    <a
      id="welcome-button"
      href="/login"
      class="mt-8 inline-block border border-primary bg-primary px-8 py-3 font-mono text-sm font-bold uppercase text-background transition-colors hover:bg-primary/80"
    >
      Go to Login &gt;&gt;
    </a>
  </main>

  <script>
    import { supabase } from "../lib/supabase";

    // --- Safe Tracking Initialization ---
    interface CustomWindow extends Window {
      dataLayer: unknown[];
      fbq: {
        (action: string, event: string): void;
        queue: unknown[][];
      };
    }

    const customWindow = window as unknown as CustomWindow;

    // For Google Ads
    customWindow.dataLayer = customWindow.dataLayer || [];
    function gtag(...args: unknown[]) {
      customWindow.dataLayer.push(...args);
    }

    // For Meta (Facebook) Pixel
    const fbq =
      customWindow.fbq ||
      function (...args: unknown[]) {
        if (customWindow.fbq.queue) {
          customWindow.fbq.queue.push(args);
        }
      };

    // --- Fire Conversion Events ---
    // Google Ads
    gtag("event", "conversion", {
      send_to: "AW-17373220374/I1elCNLhv64bEJacmdxA",
    });
    // Meta (Facebook) Pixel
    if (typeof customWindow.fbq === "function") {
      fbq("track", "CompleteRegistration");
    }

    // --- Handle Dynamic UI ---
    supabase.auth.onAuthStateChange((event, session) => {
      if (session && session.user) {
        const isSocialLogin = session.user.app_metadata.provider !== "email";

        if (isSocialLogin) {
          const messageEl = document.getElementById("welcome-message");
          const buttonEl = document.getElementById("welcome-button");

          if (messageEl) {
            messageEl.textContent =
              "Your account has been successfully created and authenticated.";
          }
          if (buttonEl) {
            buttonEl.textContent = "Go to App >>";
            buttonEl.setAttribute("href", "/app");
          }
        }
      }
    });
  </script>
</Layout>
