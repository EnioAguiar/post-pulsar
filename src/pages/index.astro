--- 
import Layout from "../layouts/Layout.astro";

const pageTitle = "PostPulsar | AI Content Repurposing for Social Media";
const pageDescription =
  "Save hours of work. PostPulsar uses AI to transform your blog posts or articles into engaging social media content for LinkedIn, Twitter, Instagram, and more. Start for free.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="container mx-auto px-4">
    <!-- Hero Section -->
    <div
      class="flex min-h-[calc(100vh-80px)] flex-col items-center justify-center text-center"
    >
      <h1 class="max-w-4xl text-5xl font-bold uppercase leading-tight">
        DECODE YOUR CONTENT<span class="text-primary">.</span> AMPLIFY YOUR REACH<span
          class="text-primary">.</span
        >
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-foreground/70">
        PostPulsar uses AI to transform your blog articles into a complete
        arsenal of content for social networks. From a single source to a dozen
        outputs.
      </p>

      <div id="cta-buttons" class="mt-8 flex justify-center space-x-4">
        <a
          href="/signup"
          class="border border-primary bg-primary px-8 py-3 font-mono text-sm font-bold uppercase text-background transition-colors hover:bg-primary/80"
          data-auth="false">Activate Protocol &gt;&gt;</a
        >
        <a
          href="/app"
          class="border border-primary bg-primary px-8 py-3 font-mono text-sm font-bold uppercase text-background transition-colors hover:bg-primary/80"
          data-auth="true"
          style="display: none;">Access Dashboard &gt;&gt;</a
        >
      </div>
    </div>

    <!-- How it Works Section -->
    <section class="py-20">
      <div class="text-center">
        <h2 class="text-4xl font-bold uppercase">From Article to Arsenal</h2>
        <p class="mt-2 text-lg text-foreground/70">
          Our AI-driven process is simple and powerful.
        </p>
      </div>
      <div
        class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3"
      >
        <!-- Step 1 -->
        <div
          class="rounded-lg border border-border bg-background/30 p-8 text-center"
        >
          <div
            class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border-2 border-primary font-mono text-3xl font-bold text-primary"
          >
            1
          </div>
          <h3 class="mt-6 text-2xl font-bold">Input Source</h3>
          <p class="mt-2 text-foreground/70">
            Provide a blog post URL or simply paste the raw text. Our system
            extracts the core message.
          </p>
        </div>
        <!-- Step 2 -->
        <div
          class="rounded-lg border border-border bg-background/30 p-8 text-center"
        >
          <div
            class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border-2 border-primary font-mono text-3xl font-bold text-primary"
          >
            2
          </div>
          <h3 class="mt-6 text-2xl font-bold">Generate Content</h3>
          <p class="mt-2 text-foreground/70">
            Our AI generates a variety of posts, threads, and summaries, including
            text, images, and video content.
          </p>
        </div>
        <!-- Step 3 -->
        <div
          class="rounded-lg border border-border bg-background/30 p-8 text-center"
        >
          <div
            class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border-2 border-primary font-mono text-3xl font-bold text-primary"
          >
            3
          </div>
          <h3 class="mt-6 text-2xl font-bold">Review & Publish</h3>
          <p class="mt-2 text-foreground/70">
            Fine-tune the generated content and publish it directly to all your
            connected social networks with one click.
          </p>
        </div>
      </div>
    </section>

    <!-- Supported Networks Section -->
    <section class="py-20">
      <div class="text-center">
        <h2 class="text-4xl font-bold uppercase">One Hub, All Your Networks</h2>
        <p class="mt-2 text-lg text-foreground/70">
          Connect to the platforms that matter most to your audience.
        </p>
      </div>
      <div
        class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4"
      >
        <div
          class="rounded-lg border border-border/50 bg-background/30 p-6 text-center font-mono text-lg"
        >
          LinkedIn
        </div>
        <div
          class="rounded-lg border border-border/50 bg-background/30 p-6 text-center font-mono text-lg"
        >
          Twitter / X
        </div>
        <div
          class="rounded-lg border border-border/50 bg-background/30 p-6 text-center font-mono text-lg"
        >
          Instagram
        </div>
        <div
          class="rounded-lg border border-border/50 bg-background/30 p-6 text-center font-mono text-lg"
        >
          Threads
        </div>
        <div
          class="rounded-lg border border-border/50 bg-background/30 p-6 text-center font-mono text-lg"
        >
          Facebook
        </div>
        <div
          class="rounded-lg border border-border/50 bg-background/30 p-6 text-center font-mono text-lg"
        >
          Discord
        </div>
        <div
          class="rounded-lg border border-border/50 bg-background/30 p-6 text-center font-mono text-lg"
        >
          Telegram
        </div>
      </div>
    </section>
  </main>
</Layout>