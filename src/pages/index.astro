---
import Layout from "../layouts/Layout.astro";
import HowItWorksSection from "../components/landing/HowItWorksSection.astro";
import SeeItInActionSection from "../components/landing/SeeItInActionSection.astro";
import SupportedNetworksSection from "../components/landing/SupportedNetworksSection.astro";
import PricingSection from "../components/landing/PricingSection.astro";
import FeaturesSection from "../components/landing/FeaturesSection.astro";

const pageTitle = "PostPulsar | AI Content Repurposing for Social Media";
const pageDescription =
  "PostPulsar: AI content repurposing. Turn blog posts into social media content for LinkedIn, Twitter, Instagram & more. Save hours, automate marketing. Free.";

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "PostPulsar",
  url: "https://www.post-pulsar.com",
  logo: "https://www.post-pulsar.com/desenho32x32.png",
  sameAs: [
    "https://x.com/PostPulsar",
    "https://www.instagram.com/post.pulsar/",
    "https://www.facebook.com/profile.php?id=61582495590035",
  ],
};
---

<Layout title={pageTitle} description={pageDescription}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema)}
  />
  <main class="container mx-auto px-4">
    <!-- Hero Section -->
    <div
      class="relative flex min-h-[calc(100vh-80px)] flex-col items-center justify-center text-center"
    >
      <h1 class="max-w-4xl text-5xl font-bold uppercase leading-tight">
        DECODE YOUR CONTENT<span class="text-primary">.</span> AMPLIFY YOUR REACH<span
          class="text-primary">.</span
        >
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-foreground/70">
        PostPulsar uses AI to transform your blog articles into a complete
        arsenal of content for social networks. From a single source to a dozen
        outputs.
      </p>

      <div id="cta-buttons" class="mt-8 flex justify-center space-x-4">
        <a
          href="/signup"
          class="border border-primary bg-primary px-8 py-3 font-mono text-sm font-bold uppercase text-background transition-colors hover:bg-primary/80"
          data-auth="false">Start For Free &gt;&gt;</a
        >
        <a
          href="/app"
          class="auth-hidden border border-primary bg-primary px-8 py-3 font-mono text-sm font-bold uppercase text-background transition-colors hover:bg-primary/80"
          data-auth="true">Access Dashboard &gt;&gt;</a
        >
      </div>

      <!-- Scroll Down Indicator -->
      <div class="scroll-indicator">
        <span class="font-mono text-sm tracking-widest">SCROLL</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mt-2 size-8 text-primary"
        >
          <path d="m7 10 5 5 5-5"></path>
        </svg>
      </div>
    </div>

    <HowItWorksSection />

    <SeeItInActionSection />

    <SupportedNetworksSection />

    <PricingSection />

    <FeaturesSection />
  </main>

  <!-- Image Lightbox Modal -->
  <div
    id="lightbox-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4"
  >
    <div class="relative max-h-[90vh] max-w-6xl">
      <img
        id="lightbox-image"
        src=""
        alt="Enlarged feature view"
        class="size-full object-contain"
      />
      <button
        id="lightbox-close"
        class="absolute right-2 top-2 text-3xl font-bold text-white"
        >&times;</button
      >
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const modal = document.getElementById("lightbox-modal");
      const modalImage = document.getElementById(
        "lightbox-image",
      ) as HTMLImageElement;
      const closeButton = document.getElementById("lightbox-close");
      const images = document.querySelectorAll(".feature-image");

      if (!modal || !modalImage || !closeButton) return;

      images.forEach((image) => {
        image.addEventListener("click", () => {
          const imgElement = image as HTMLImageElement;
          modalImage.src = imgElement.src;
          modal.classList.remove("hidden");
          modal.classList.add("flex");
        });
      });

      const closeModal = () => {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      };

      closeButton.addEventListener("click", closeModal);
      modal.addEventListener("click", (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });
    });
  </script>
</Layout>

<style>
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    animation: bounce 2s ease-in-out infinite;
    opacity: 0.7;
    transition: opacity 0.3s;
  }

  .scroll-indicator:hover {
    opacity: 1;
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, -20px);
    }
  }
</style>