---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Become an Affiliate - PostPulsar";
const pageDescription = "Join the PostPulsar affiliate program and earn 30% recurring commission by promoting our AI-powered content repurposing tool.";
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="container mx-auto px-4 py-12 text-foreground">
    <div class="max-w-4xl w-full mx-auto space-y-8 text-center">
      <h1 class="text-5xl font-extrabold sm:text-6xl tracking-tight">
        Partner with PostPulsar<span class="text-primary">.</span>
      </h1>
      <p class="mt-4 text-xl text-foreground/80">
        Earn a generous 30% recurring commission by promoting the ultimate AI tool for content creators!
      </p>

      <div class="mt-10">
        <a href="https://postpulsar.promotekit.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-3 border border-primary bg-primary text-background font-bold uppercase text-sm transition-colors hover:bg-primary/80">
          Join Our Affiliate Program &gt;&gt;
        </a>
      </div>

      <div class="mt-16 pt-8 border-t border-border/50 text-left">
        <h2 class="text-3xl font-bold text-center">How it Works: Simple Steps to Success</h2>
        <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="border border-border/50 bg-background/50 p-6 rounded-lg">
            <h3 class="text-xl font-semibold text-primary">1. Sign Up</h3>
            <p class="mt-2 text-foreground/80">
              Easily join our program through our secure affiliate portal. It's quick, free, and designed for immediate access.
            </p>
          </div>
          <div class="border border-border/50 bg-background/50 p-6 rounded-lg">
            <h3 class="text-xl font-semibold text-primary">2. Promote</h3>
            <p class="mt-2 text-foreground/80">
              Access a variety of creative assets, unique tracking links, and marketing materials to effortlessly promote PostPulsar.
            </p>
          </div>
          <div class="border border-border/50 bg-background/50 p-6 rounded-lg">
            <h3 class="text-xl font-semibold text-primary">3. Earn</h3>
            <p class="mt-2 text-foreground/80">
              Receive 30% recurring commission for every successful referral. Watch your earnings grow as your audience benefits!
            </p>
          </div>
        </div>
      </div>

      <div class="mt-16 pt-8 border-t border-border/50 text-left">
        <h2 class="text-3xl font-bold text-center">Why PostPulsar is Perfect for Your Audience</h2>
        <ul class="mt-8 text-base text-foreground/80 space-y-4">
          <li class="flex items-start">
            <svg class="h-6 w-6 text-primary mr-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span class="font-semibold text-foreground/80">Solve a Real Problem:</span> PostPulsar transforms one blog post into multiple social media formats, saving content creators hours of manual work.
          </li>
          <li class="flex items-start">
            <svg class="h-6 w-6 text-primary mr-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span class="font-semibold text-foreground/80">High Conversion Rates:</span> Our product delivers immense value, leading to satisfied customers and higher conversion rates for your referrals.
          </li>
          <li class="flex items-start">
            <svg class="h-6 w-6 text-primary mr-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
            <span class="font-semibold text-foreground/80">Dedicated Support:</span> We provide our affiliates with all the resources and support needed to succeed.
          </li>
        </ul>
      </div>

      <div class="mt-16">
         <a href="https://postpulsar.promotekit.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-3 border border-primary bg-primary text-background font-bold uppercase text-sm transition-colors hover:bg-primary/80">
          Start Earning Today &gt;&gt;
        </a>
      </div>
    </div>
  </main>
</Layout>
