---
import Layout from "../../layouts/Layout.astro";
import Modal from "../../components/Modal.astro";
---

<Layout title="Post History // PostPulsar">
  <main class="container py-12">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-bold uppercase">// Post History</h1>
      <a
        href="/app"
        class="font-mono text-sm uppercase text-foreground/70 hover:text-primary"
        >&lt; Back to Dashboard</a
      >
    </div>

    <p class="mt-2 text-foreground/70">
      Manage your previously generated posts. Your history is automatically
      managed, keeping the latest 20 posts.
    </p>
    <div
      class="mt-4 rounded-lg border border-yellow-400/50 bg-yellow-400/10 p-4 text-sm text-yellow-300"
    >
      <p>
        <span class="font-bold">NOTE:</span> The Insights data shown on this page
        is part of a feature currently in development. Metrics may not be available
        for all networks yet.
      </p>
    </div>

    <div id="history-container" class="mt-8 space-y-6">
      <!-- Posts will be loaded here by client-side script -->
      <div class="border border-dashed border-border p-8 text-center">
        <p class="font-mono text-foreground/70">Loading history...</p>
      </div>
    </div>
  </main>

  <Modal />

  <script>
    import { supabase } from "../../lib/supabase";
    import { showModal, hideModal } from "../../lib/modal";
    import { saveReopenPost } from "../../lib/ui/storageManager";
    import { userSession } from "../../lib/user-session";

    const historyContainer = document.getElementById("history-container");
    let postsData = [];

    function getPreviewText(content) {
      if (!content) return "No preview available";
      const previewOrder = [
        "linkedin",
        "facebook",
        "instagram",
        "threads",
        "twitter",
        "discord",
        "telegram",
      ];
      for (const network of previewOrder) {
        if (content[network]) {
          return content[network].substring(0, 150);
        }
      }
      return "No preview available";
    }

    async function loadHistory() {
      if (!historyContainer) return;

      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) {
        window.location.href = "/login";
        return;
      }

      // Initialize user session and fetch plan details
      userSession.init(supabase, user.id);
      await userSession.fetchUserProfile();
      const isPro = userSession.isPro();

      const { data: posts, error } = await supabase
        .from("generated_posts")
        .select(
          "id, created_at, source_url, content, media_map, generated_image_url, instagram_likes, instagram_comments, instagram_reach, threads_likes, threads_replies, threads_reposts, facebook_likes, facebook_comments, facebook_shares",
        )
        .eq("user_id", user.id)
        .order("created_at", { ascending: false });

      if (error) {
        historyContainer.innerHTML = `<p class="text-red-400">Error loading history: ${error.message}</p>`;
        return;
      }

      if (posts.length === 0) {
        historyContainer.innerHTML = `<div class="border border-dashed border-border p-8 text-center"><p class="font-mono text-foreground/70">No posts found in your history.</p></div>`;
        return;
      }

      postsData = posts;

      historyContainer.innerHTML = posts
        .map((post) => {
          const contentPreview = getPreviewText(post.content);

          let metricsBlock = "";
          if (isPro) {
            const igMetrics =
              post.instagram_likes > 0 ||
              post.instagram_comments > 0 ||
              post.instagram_reach > 0;
            const thMetrics =
              post.threads_likes > 0 ||
              post.threads_replies > 0 ||
              post.threads_reposts > 0;
            const fbMetrics =
              post.facebook_likes > 0 ||
              post.facebook_comments > 0 ||
              post.facebook_shares > 0;

            if (igMetrics || thMetrics || fbMetrics) {
              metricsBlock = `
                    <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-2 text-sm text-foreground/70 font-mono">
                      ${
                        igMetrics
                          ? `
                        <div class="col-span-full font-bold text-foreground">Instagram:</div>
                        ${post.instagram_likes > 0 ? `<div class="flex items-center gap-1"><span class="text-primary">❤️</span> ${post.instagram_likes}</div>` : ""}
                        ${post.instagram_comments > 0 ? `<div class="flex items-center gap-1"><span class="text-primary">💬</span> ${post.instagram_comments}</div>` : ""}
                        ${post.instagram_reach > 0 ? `<div class="flex items-center gap-1"><span class="text-primary">👁️</span> ${post.instagram_reach}</div>` : ""}
                      `
                          : ""
                      }
                      ${
                        thMetrics
                          ? `
                        <div class="col-span-full font-bold text-foreground mt-2">Threads:</div>
                        ${post.threads_likes > 0 ? `<div class="flex items-center gap-1"><span class="text-primary">❤️</span> ${post.threads_likes}</div>` : ""}
                        ${post.threads_replies > 0 ? `<div class="flex items-center gap-1"><span class="text-primary">💬</span> ${post.threads_replies}</div>` : ""}
                        ${post.threads_reposts > 0 ? `<div class="flex items-center gap-1"><span class="text-primary">🔁</span> ${post.threads_reposts}</div>` : ""}
                      `
                          : ""
                      }
                      ${
                        fbMetrics
                          ? `
                        <div class="col-span-full font-bold text-foreground mt-2">Facebook:</div>
                        ${post.facebook_likes > 0 ? `<div class="flex items-center gap-1"><span class="text-primary">👍</span> ${post.facebook_likes}</div>` : ""}
                        ${post.facebook_comments > 0 ? `<div class="flex items-center gap-1"><span class="text-primary">💬</span> ${post.facebook_comments}</div>` : ""}
                        ${post.facebook_shares > 0 ? `<div class="flex items-center gap-1"><span class="text-primary">🔗</span> ${post.facebook_shares}</div>` : ""}
                      `
                          : ""
                      }
                    </div>`;
            } else {
              metricsBlock = `
                <div class="mt-4 rounded-md border border-dashed border-border/50 bg-background-light p-3 text-center">
                    <p class="text-sm text-foreground/60">No analytics data available for this post yet.</p>
                </div>
                `;
            }
          } else {
            metricsBlock = `
                <div class="mt-4 rounded-md border border-dashed border-primary/50 bg-primary/10 p-4 text-center">
                    <p class="font-bold text-primary">⭐️ Unlock Post Insights</p>
                    <p class="text-sm text-foreground/80">Upgrade to Pro to view post analytics.</p>
                    <a href="/app/billing" class="mt-2 inline-block text-sm font-bold text-primary underline hover:no-underline">Upgrade Now</a>
                </div>`;
          }

          return `
          <div class="history-card border border-border/50 p-4" data-post-id="${post.id}">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-grow min-w-0">
                <p class="font-mono text-sm text-foreground/50">${new Date(post.created_at).toLocaleString()}</p>
                <a href="${post.source_url}" target="_blank" rel="noopener noreferrer" class="text-lg font-bold hover:text-primary truncate block">${post.source_url || "Pulsed from raw text"}</a>
                <p class="mt-2 text-foreground/80 italic">"${contentPreview}..."</p>
                ${metricsBlock}
              </div>
              <div class="flex flex-col gap-2 flex-shrink-0">
                <button class="reopen-post-btn border border-primary px-4 py-2 font-mono text-sm uppercase text-primary hover:bg-primary/10">Reopen</button>
                <button class="delete-post-btn border border-red-500/50 text-red-400 px-4 py-2 font-mono text-sm uppercase hover:bg-red-500/10">Delete</button>
              </div>
            </div>
          </div>
        `;
        })
        .join("");
    }

    historyContainer?.addEventListener("click", async (e) => {
      const target = e.target;
      const card = target.closest(".history-card");
      if (!card) return;

      const postId = card.dataset.postId;
      if (!postId) return;

      if (target.classList.contains("delete-post-btn")) {
        const confirmDelete = () => {
          hideModal();
          deletePost(postId, card);
        };

        showModal(
          "// Confirm Deletion",
          '<p class="text-foreground/80">Are you sure you want to permanently delete this post from your history?</p>',
          `<button data-modal-close class="border border-border px-4 py-2 font-mono text-sm uppercase hover:bg-gray-800">Cancel</button>
           <button id="confirm-delete-btn" class="border border-red-500 bg-red-500 px-4 py-2 font-mono text-sm font-bold uppercase text-background">Delete</button>`,
        );

        document
          .getElementById("confirm-delete-btn")
          ?.addEventListener("click", confirmDelete, { once: true });
      } else if (target.classList.contains("reopen-post-btn")) {
        const postToReopen = postsData.find((p) => p.id == postId);
        if (postToReopen) {
          const dataToStore = {
            generatedContent: postToReopen.content,
            sourceUrl: postToReopen.source_url,
            mediaMap: postToReopen.media_map,
            generatedImageUrl: postToReopen.generated_image_url,
          };
          saveReopenPost(dataToStore);
          window.location.href = "/app";
        }
      }
    });

    async function deletePost(postId, cardElement) {
      try {
        const { error } = await supabase
          .from("generated_posts")
          .delete()
          .eq("id", postId);
        if (error) throw error;
        cardElement.remove();
      } catch (err) {
        showModal(
          "// Error",
          `<p>Failed to delete post: ${err.message}</p>`,
          `<button data-modal-close class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase">OK</button>`,
        );
      }
    }

    loadHistory();
  </script>
</Layout>
