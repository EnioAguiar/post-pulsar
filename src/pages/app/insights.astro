---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Insights // PostPulsar">
  <main class="container py-12">
    <div id="pro-gate" class="hidden">
      <div
        class="flex h-96 flex-col items-center justify-center rounded-lg border-2 border-dashed border-primary/50 bg-primary/10 text-center"
      >
        <div class="text-4xl">⭐️</div>
        <h2 class="mt-4 text-2xl font-bold uppercase text-primary">
          Unlock Post Insights
        </h2>
        <p class="mt-2 max-w-md text-foreground/80">
          This is a Pro feature. Upgrade your plan to get detailed analytics on
          your published posts and find out what content resonates with your
          audience.
        </p>
        <div class="mt-6">
          <a href="/app/billing" class="inline-block border border-primary bg-primary px-6 py-3 font-mono text-base font-bold uppercase text-background transition-colors hover:bg-primary/80">Upgrade to Pro</a>
        </div>
      </div>
    </div>

    <div id="insights-content" class="hidden">
      <div class="mb-12">
        <h1 class="text-3xl font-bold uppercase">// Analytics & Insights</h1>
        <p class="mt-1 text-foreground/70">
          Refresh and analyze the performance of your published content.
        </p>
        <div class="mt-4 rounded-lg border border-yellow-400/50 bg-yellow-400/10 p-4 text-sm text-yellow-300">
          <p><span class="font-bold">NOTE:</span> This feature is currently in development. Some metrics may not be available for all networks, and data accuracy is still being improved.</p>
        </div>
      </div>

      <div id="loading-indicator">
        <p class="text-center text-foreground/50">Loading posts...</p>
      </div>

      <div id="empty-state" class="hidden">
        <div
          class="flex h-64 flex-col items-center justify-center rounded-lg border-2 border-dashed border-border"
        >
          <p class="text-foreground/50">You have no published posts yet.</p>
          <p class="mt-2 text-xs text-foreground/60">
            Once you publish a post, it will appear here.
          </p>
        </div>
      </div>

        <!-- LinkedIn Member Insights Section (NEW) -->
        <div id="linkedin-member-insights-section" class="border border-border p-6 mt-8 rounded-lg hidden">
            <h2 class="text-xl font-bold uppercase border-b border-border pb-3">LinkedIn Member Analytics</h2>
            <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                <p>Impressions: <span class="font-bold" id="linkedin-impressions">N/A</span></p>
                <p>Reactions: <span class="font-bold" id="linkedin-reactions">N/A</span></p>
                <p>Comments: <span class="font-bold" id="linkedin-comments">N/A</span></p>
                <p>Reshares: <span class="font-bold" id="linkedin-reshares">N/A</span></p>
                <p>Members Reached: <span class="font-bold" id="linkedin-members-reached">N/A</span></p>
            </div>
            <div class="mt-4 text-right">
                <button id="refresh-linkedin-member-insights" class="refresh-btn border border-primary px-3 py-1 text-xs font-bold uppercase text-primary transition-colors hover:bg-primary/10 disabled:opacity-50 disabled:cursor-not-allowed">
                    Refresh LinkedIn Analytics
                </button>
            </div>
        </div>

      <div
        id="insights-posts-container"
        class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"
      >
        <!-- Post cards will be dynamically inserted here -->
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from "../../lib/supabase";
  import { userSession } from "../../lib/user-session";

  async function initializePage() {
    console.log("DEBUG: Initializing insights page...");
    const proGate = document.getElementById("pro-gate");
    const insightsContent = document.getElementById("insights-content");

    if (!proGate || !insightsContent) {
        console.error("DEBUG: pro-gate or insights-content element not found!");
        return;
    }
    console.log("DEBUG: All main elements found.");

    try {
        const { data: { user }, error: userError } = await supabase.auth.getUser();
        if (userError || !user) {
          console.error("DEBUG: User not found or error fetching user.", userError);
          window.location.href = "/login";
          return;
        }
        console.log("DEBUG: User found:", user.id);

        userSession.init(supabase, user.id);
        console.log("DEBUG: User session initialized. Fetching profile...");
        await userSession.fetchUserProfile();
        console.log("DEBUG: User profile fetched. Plan is:", userSession.getPlanType());

        if (userSession.isPro()) {
          console.log("DEBUG: User is Pro. Showing content.");
          insightsContent.classList.remove("hidden");
          loadPosts(user.id);
          loadLinkedInMemberInsights(user.id); // Call new function
        } else {
          console.log("DEBUG: User is not Pro. Showing pro-gate.");
          proGate.classList.remove("hidden");
        }
    } catch (err) {
        console.error("DEBUG: An unexpected error occurred in initializePage:", err);
        document.body.innerHTML = '<p class="text-red-500 text-center p-8">A critical error occurred. Please check the console.</p>';
    }
  }

  function renderPostCard(post, provider) {
    const contentSnippet =
      post.content[provider]?.substring(0, 150) + "..." ||
      "No content snippet available.";

    let metricsHTML = "";
    switch (provider) {
      case "instagram":
        metricsHTML = `
                <p>Likes: <span class="font-bold" data-metric="likes">${
                  post.instagram_likes ?? 0
                }</span></p>
                <p>Comments: <span class="font-bold" data-metric="comments">${
                  post.instagram_comments ?? 0
                }</span></p>
                <p>Reach: <span class="font-bold" data-metric="reach">${
                  post.instagram_reach ?? 0
                }</span></p>
            `;
        break;
      case "threads":
        metricsHTML = `
                <p>Likes: <span class="font-bold" data-metric="likes">${
                  post.threads_likes ?? 0
                }</span></p>
                <p>Replies: <span class="font-bold" data-metric="replies">${
                  post.threads_replies ?? 0
                }</span></p>
            `;
        break;
      case "facebook":
        metricsHTML = `
                <p>Likes: <span class="font-bold" data-metric="likes">${
                  post.facebook_likes ?? 0
                }</span></p>
                <p>Comments: <span class="font-bold" data-metric="comments">${
                  post.facebook_comments ?? 0
                }</span></p>
                <p>Shares: <span class="font-bold" data-metric="shares">${
                  post.facebook_shares ?? 0
                }</span></p>
            `;
        break;
      default:
        metricsHTML =
          '<p class="text-xs text-foreground/50">Analytics not supported for this network.</p>';
        break;
    }

    const card = document.createElement("div");
    card.className =
      "post-card border border-border p-4 rounded-lg flex flex-col gap-4";
    card.setAttribute("data-post-id", post.id);
    card.setAttribute("data-provider", provider);
    card.innerHTML = `
        <div>
            <p class="text-xs text-foreground/60">Posted to ${provider} on ${new Date(
              post.created_at,
            ).toLocaleDateString()}</p>
            <p class="mt-2 text-sm text-foreground/80">${contentSnippet}</p>
        </div>
        <div class="metrics-container text-sm space-y-1">${metricsHTML}</div>
        <div class="mt-auto pt-4 text-right">
            <button class="refresh-btn border border-primary px-3 py-1 text-xs font-bold uppercase text-primary transition-colors hover:bg-primary/10 disabled:opacity-50 disabled:cursor-not-allowed">
                Refresh Metrics
            </button>
        </div>
    `;
    return card;
  }

  async function handleRefreshClick(event) {
    const button = event.currentTarget;
    const card = button.closest(".post-card");
    const postId = card.dataset.postId;
    const provider = card.dataset.provider;

    if (!postId || !provider) {
      alert("Error: Post ID or provider missing.");
      return;
    }

    button.disabled = true;
    button.textContent = "Refreshing...";

    try {
      const { data, error } = await supabase.functions.invoke(
        "refresh-post-analytics",
        {
          body: { postId, provider },
        },
      );

      if (error || data.status === "error") {
        throw new Error(data.error || error.message);
      }

      const newMetrics = data.newMetrics;
      const metricsContainer = card.querySelector(".metrics-container");

      if (newMetrics.likes !== undefined)
        metricsContainer.querySelector('[data-metric="likes"]').textContent =
          newMetrics.likes;
      if (newMetrics.comments !== undefined)
        metricsContainer.querySelector('[data-metric="comments"]').textContent =
          newMetrics.comments;
      if (newMetrics.reach !== undefined)
        metricsContainer.querySelector('[data-metric="reach"]').textContent =
          newMetrics.reach;
      if (newMetrics.replies !== undefined)
        metricsContainer.querySelector('[data-metric="replies"]').textContent =
          newMetrics.replies;
       if (newMetrics.shares !== undefined)
        metricsContainer.querySelector('[data-metric="shares"]').textContent =
          newMetrics.shares;

    } catch (err) {
      alert("Failed to refresh metrics: " + err.message);
    } finally {
      button.disabled = false;
      button.textContent = "Refresh Metrics";
    }
  }

  async function loadPosts(userId) {
    const postsContainer = document.getElementById("insights-posts-container");
    const loadingIndicator = document.getElementById("loading-indicator");
    const emptyState = document.getElementById("empty-state");

    if (!postsContainer || !loadingIndicator || !emptyState) {
      return;
    }

    try {
      const { data: posts, error } = await supabase
        .from("generated_posts")
        .select("*")
        .eq("user_id", userId)
        .not("provider_post_ids", "is", null) 
        .order("created_at", { ascending: false });

      if (error) throw error;

      loadingIndicator.classList.add("hidden");

      if (!posts || posts.length === 0) {
        emptyState.classList.remove("hidden");
        return;
      }
      
      let renderedSomething = false;
      posts.forEach((post) => {
        if (post.provider_post_ids && typeof post.provider_post_ids === 'object') {
            for (const provider in post.provider_post_ids) {
                if (Object.prototype.hasOwnProperty.call(post.provider_post_ids, provider)) {
                    const card = renderPostCard(post, provider);
                    postsContainer.appendChild(card);
                    renderedSomething = true;
                }
            }
        }
      });

      if (renderedSomething) {
        document.querySelectorAll(".refresh-btn").forEach((btn) => {
          btn.addEventListener("click", handleRefreshClick);
        });
      } else {
        emptyState.classList.remove("hidden");
      }

    } catch (err) {
      console.error("Error loading posts:", err);
      loadingIndicator.classList.add("hidden");
      postsContainer.innerHTML =
        '<p class="text-red-500">Could not load posts. Check the developer console for errors.</p>';
    }
  }

  async function loadLinkedInMemberInsights(userId, button = null) {
    const linkedinSection = document.getElementById("linkedin-member-insights-section");
    const refreshButton = button || document.getElementById("refresh-linkedin-member-insights");

    if (!linkedinSection || !refreshButton) {
      console.error("LinkedIn insights section or refresh button not found.");
      return;
    }

    if (button) { // Only set loading state if called from a button click
      refreshButton.disabled = true;
      refreshButton.textContent = "Refreshing...";
    }
    linkedinSection.classList.remove("border-green-500", "border-red-500");
    linkedinSection.classList.add("border-border");


    try {
      // Check if user has a linkedin-insights connection
      const { data: connections, error: connError } = await supabase
        .from("social_connections")
        .select("id")
        .eq("user_id", userId)
        .eq("provider", "linkedin")
        .eq("purpose", "insights")
        .single();

      if (connError || !connections) {
        linkedinSection.classList.remove("hidden"); // Show section even if not connected
        linkedinSection.innerHTML = `
          <h2 class="text-xl font-bold uppercase border-b border-border pb-3">LinkedIn Member Analytics</h2>
          <p class="mt-4 text-sm text-red-400">Not connected for LinkedIn Insights. Please go to <a href="/app/connections" class="underline">Connections</a> to link your account for insights.</p>
        `;
        return;
      }

      linkedinSection.classList.remove("hidden"); // Show section if connection exists

      const { data, error } = await supabase.functions.invoke(
        "get-linkedin-member-insights",
        { body: { userId: userId } },
      );

      if (error || data.status === "error") {
        throw new Error(data.error || error.message);
      }

      const insights = data.data;

      document.getElementById("linkedin-impressions").textContent = insights.impressions ?? 'N/A';
      document.getElementById("linkedin-reactions").textContent = insights.reactions ?? 'N/A';
      document.getElementById("linkedin-comments").textContent = insights.comments ?? 'N/A';
      document.getElementById("linkedin-reshares").textContent = insights.reshares ?? 'N/A';
      document.getElementById("linkedin-members-reached").textContent = insights.membersReached ?? 'N/A';
      
      linkedinSection.classList.remove("border-border");
      linkedinSection.classList.add("border-green-500");


    } catch (err) {
      console.error("Error loading LinkedIn member insights:", err);
      linkedinSection.classList.remove("hidden");
      linkedinSection.classList.add("border-red-500");
      let errorMessage = "Failed to load LinkedIn member insights.";
      if (err.message.includes("SESSION_EXPIRED")) {
        errorMessage = "LinkedIn Insights session expired. Please re-link your account on the <a href='/app/connections' class='underline'>Connections page</a>.";
      } else if (err.message.includes("connection not found")) {
        errorMessage = "LinkedIn Insights connection not found. Please link your account on the <a href='/app/connections' class='underline'>Connections page</a>.";
      }

      linkedinSection.innerHTML = `
        <h2 class="text-xl font-bold uppercase border-b border-border pb-3">LinkedIn Member Analytics</h2>
        <p class="mt-4 text-sm text-red-400">${errorMessage}</p>
        <div class="mt-4 text-right">
            <button id="refresh-linkedin-member-insights" class="refresh-btn border border-primary px-3 py-1 text-xs font-bold uppercase text-primary transition-colors hover:bg-primary/10">
                Refresh LinkedIn Analytics
            </button>
        </div>
      `;
      document.getElementById("refresh-linkedin-member-insights")?.addEventListener("click", (e) => loadLinkedInMemberInsights(userSession.getUserId(), e.currentTarget));

    } finally {
      if (button) {
        refreshButton.disabled = false;
        refreshButton.textContent = "Refresh LinkedIn Analytics";
      }
    }
  }

  document.addEventListener("DOMContentLoaded", initializePage);
  document.getElementById("refresh-linkedin-member-insights")?.addEventListener("click", (e) => loadLinkedInMemberInsights(userSession.getUserId(), e.currentTarget));
</script>