---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Connections // PostPulsar">
  <main class="container py-12">
    <div class="mb-12">
      <h1 class="text-3xl font-bold uppercase">// Posting Connections</h1>
      <p class="mt-1 text-foreground/70">
        Connect your social media accounts to post content directly.
      </p>
    </div>

    <div class="space-y-8">
      <div class="border border-border p-6">
        <h2 class="border-b border-border pb-3 text-xl font-bold uppercase">
          Available Networks
        </h2>
        <div class="mt-4 max-w-sm">
          <!-- LinkedIn Button -->
          <button
            id="link-linkedin-btn"
            class="flex w-full items-center justify-center border border-border bg-transparent p-3 font-mono text-sm font-bold uppercase text-foreground transition-colors hover:bg-border/50"
          >
            <svg class="mr-3 size-5" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
              ></path>
            </svg>
            <span id="link-linkedin-btn-text">Link LinkedIn Account</span>
          </button>
        </div>
      </div>
    </div>
  </main>

  <!-- Custom Themed Modal -->
  <div id="custom-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 font-mono">
    <div class="w-full max-w-sm border border-border bg-background p-6 text-center">
      <h3 id="modal-title" class="text-xl font-bold uppercase"></h3>
      <p id="modal-text" class="mt-2 text-foreground/80"></p>
      <div class="mt-6 flex justify-center gap-4">
        <button id="modal-cancel-btn" class="border border-border px-6 py-2 text-sm uppercase transition-colors hover:bg-border/50">Cancel</button>
        <button id="modal-confirm-btn" class="border border-red-500 bg-red-500/10 px-6 py-2 text-sm uppercase text-red-500 transition-colors hover:bg-red-500/20">Confirm</button>
      </div>
    </div>
  </div>

</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  // --- Element References ---
  const linkBtn = document.getElementById("link-linkedin-btn") as HTMLButtonElement;
  const btnText = document.getElementById("link-linkedin-btn-text") as HTMLSpanElement;
  const modal = document.getElementById("custom-modal") as HTMLDivElement;
  const modalTitle = document.getElementById("modal-title") as HTMLHeadingElement;
  const modalText = document.getElementById("modal-text") as HTMLParagraphElement;
  const modalCancelBtn = document.getElementById("modal-cancel-btn") as HTMLButtonElement;
  const modalConfirmBtn = document.getElementById("modal-confirm-btn") as HTMLButtonElement;

  let onConfirmCallback: (() => void) | null = null;

  // --- Modal Functions ---
  const openModal = (title: string, text: string, type: 'confirm' | 'alert') => {
    modalTitle.textContent = title;
    modalText.textContent = text;
    modalConfirmBtn.style.display = type === 'confirm' ? "" : "none";
    modalCancelBtn.textContent = type === 'confirm' ? "Cancel" : "Close";
    modal.classList.remove("hidden");
    modal.classList.add("flex");
  };

  const closeModal = () => {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    onConfirmCallback = null;
  };

  // --- UI Update Function ---
  const updateUI = (status: "connected" | "disconnected" | "loading") => {
    if (!linkBtn || !btnText) return;

    linkBtn.disabled = status === "loading";
    btnText.textContent = status === "loading" ? "Loading..." : status === "connected" ? "Unlink LinkedIn Account" : "Link LinkedIn Account";
    linkBtn.dataset.status = status;

    if (status === "connected") {
      linkBtn.classList.add("border-green-500", "hover:bg-green-500/10");
      linkBtn.classList.remove("border-border", "hover:bg-border/50");
    } else {
      linkBtn.classList.add("border-border", "hover:bg-border/50");
      linkBtn.classList.remove("border-green-500", "hover:bg-green-500/10");
    }
  };

  // --- Main Logic Handler ---
  const handleLinkClick = () => {
    const status = linkBtn.dataset.status;
    if (status === "connected") {
      onConfirmCallback = performUnlink;
      openModal("Confirm Unlink", "Are you sure you want to unlink your LinkedIn account?", "confirm");
    } else if (status === "disconnected") {
      performLink();
    }
  };

  // --- Account Linking/Unlinking Functions ---
  const performLink = async () => {
    updateUI("loading");
    try {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) throw new Error("User not logged in.");

      const { data, error } = await supabase.functions.invoke("linkedin-auth-start", { body: { userId: user.id } });
      if (error) throw error;
      window.location.href = data.authorizationUrl;
    } catch (error) {
      openModal("Error", error.message, "alert");
      updateUI("disconnected");
    }
  };

  const performUnlink = async () => {
    updateUI("loading");
    try {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) throw new Error("User not logged in.");

      const { error } = await supabase.from("social_connections").delete().match({ user_id: user.id, provider: "linkedin" });
      if (error) throw error;

      openModal("Success", "LinkedIn account unlinked successfully.", "alert");
      updateUI("disconnected");
    } catch (error) {
      openModal("Error", error.message, "alert");
      updateUI("connected"); // Revert UI if unlinking fails
    }
  };

  // --- Initial Status Check ---
  const checkInitialStatus = async () => {
    updateUI("loading");
    try {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) {
        updateUI("disconnected");
        return;
      }

      const { data, error } = await supabase.from("social_connections").select("id").eq("user_id", user.id).eq("provider", "linkedin").maybeSingle();
      if (error) throw error;

      updateUI(data ? "connected" : "disconnected");
    } catch (error) {
      openModal("Error", `Error checking connection status: ${error.message}`, "alert");
      updateUI("disconnected");
    }
  };

  // --- Event Listeners ---
  linkBtn?.addEventListener("click", handleLinkClick);
  modalCancelBtn?.addEventListener("click", closeModal);
  modalConfirmBtn?.addEventListener("click", () => {
    if (onConfirmCallback) {
      onConfirmCallback();
    }
    closeModal();
  });
  document.addEventListener("DOMContentLoaded", checkInitialStatus);

</script>
