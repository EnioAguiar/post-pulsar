---
import Layout from "../../layouts/Layout.astro";
import Modal from "../../components/Modal.astro";
---

<Layout title="Connections // PostPulsar">
  <main class="container py-12">
    <div class="mb-12">
      <h1 class="text-3xl font-bold uppercase">// Posting Connections</h1>
      <p class="mt-1 text-foreground/70">
        Connect your social media accounts to post content directly.
      </p>
    </div>

    <div class="space-y-8">
      <div class="border border-border p-6">
        <h2 class="border-b border-border pb-3 text-xl font-bold uppercase">
          Available Networks
        </h2>
        <div class="mt-4 max-w-sm space-y-6">
          <!-- LinkedIn Block -->
          <div class="border border-border p-4" data-network="linkedin">
            <button
              class="link-btn flex w-full items-center justify-center bg-transparent p-2 font-mono text-sm font-bold uppercase text-foreground"
              data-status="disconnected"
            >
              <svg class="mr-3 size-5" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
                ></path>
              </svg>
              <span class="btn-text">Link LinkedIn Account</span>
            </button>
            <p class="mt-2 text-center text-xs text-foreground/60">
              (Currently supports Personal Profiles only, not Company Pages)
            </p>
          </div>

          <!-- Twitter/X Block -->
          <div class="border border-border p-4" data-network="twitter">
            <button
              class="link-btn flex w-full items-center justify-center bg-transparent p-2 font-mono text-sm font-bold uppercase text-foreground"
              data-status="disconnected"
            >
              <svg class="mr-3 size-5" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                ></path>
              </svg>
              <span class="btn-text">Link Twitter (X) Account</span>
            </button>
          </div>

          <!-- Instagram Block -->
          <div class="border border-border p-4" data-network="instagram">
            <button
              class="link-btn flex w-full items-center justify-center bg-transparent p-2 font-mono text-sm font-bold uppercase text-foreground"
              data-status="disconnected"
            >
              <svg class="mr-3 size-5" viewBox="0 0 16 16" fill="currentColor">
                <path
                  d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z"
                ></path>
              </svg>
              <span class="btn-text">Link Instagram Account</span>
            </button>
            <p class="mt-2 text-center text-xs text-foreground/60">
              (Requires an Instagram Professional Account - Business or Creator)
            </p>
          </div>

          <!-- Threads Block -->
          <div class="border border-border p-4" data-network="threads">
            <button
              class="link-btn flex w-full items-center justify-center bg-transparent p-2 font-mono text-sm font-bold uppercase text-foreground"
              data-status="disconnected"
            >
              <svg
                class="mr-3 size-5"
                aria-label="Threads"
                viewBox="0 0 192 192"
                xmlns="http://www.w3.org/2000/svg"
                fill="currentColor"
                ><path
                  d="M141.537 88.9883C140.71 88.5919 139.87 88.2104 139.019 87.8451C137.537 60.5382 122.616 44.905 97.5619 44.745C97.4484 44.7443 97.3355 44.7443 97.222 44.7443C82.2364 44.7443 69.7731 51.1409 62.102 62.7807L75.881 72.2328C81.6116 63.5383 90.6052 61.6848 97.2286 61.6848C97.3051 61.6848 97.3819 61.6848 97.4576 61.6855C105.707 61.7381 111.932 64.1366 115.961 68.814C118.893 72.2193 120.854 76.925 121.825 82.8638C114.511 81.6207 106.601 81.2385 98.145 81.7233C74.3247 83.0954 59.0111 96.9879 60.0396 116.292C60.5615 126.084 65.4397 134.508 73.775 140.011C80.8224 144.663 89.899 146.938 99.3323 146.423C111.79 145.74 121.563 140.987 128.381 132.296C133.559 125.696 136.834 117.143 138.28 106.366C144.217 109.949 148.617 114.664 151.047 120.332C155.179 129.967 155.42 145.8 142.501 158.708C131.182 170.016 117.576 174.908 97.0135 175.059C74.2042 174.89 56.9538 167.575 45.7381 153.317C35.2355 139.966 29.8077 120.682 29.6052 96C29.8077 71.3178 35.2355 52.0336 45.7381 38.6827C56.9538 24.4249 74.2039 17.11 97.0132 16.9405C119.988 17.1113 137.539 24.4614 149.184 38.788C154.894 45.8136 159.199 54.6488 162.037 64.9503L178.184 60.6422C174.744 47.9622 169.331 37.0357 161.965 27.974C147.036 9.60668 125.202 0.195148 97.0695 0H96.9569C68.8816 0.19447 47.2921 9.6418 32.7883 28.0793C19.8819 44.4864 13.2244 67.3157 13.0007 95.9325L13 96L13.0007 96.0675C13.2244 124.684 19.8819 147.514 32.7883 163.921C47.2921 182.358 68.8816 191.806 96.9569 192H97.0695C122.03 191.827 139.624 185.292 154.118 170.811C173.081 151.866 172.51 128.119 166.26 113.541C161.776 103.087 153.227 94.5962 141.537 88.9883ZM98.4405 129.507C88.0005 130.095 77.1544 125.409 76.6196 115.372C76.2232 107.93 81.9158 99.626 99.0812 98.6368C101.047 98.5234 102.976 98.468 104.871 98.468C111.106 98.468 116.939 99.0737 122.242 100.233C120.264 124.935 108.662 128.946 98.4405 129.507Z"
                ></path></svg
              >
              <span class="btn-text">Link Threads Account</span>
            </button>
          </div>

          <!-- Facebook Block -->
          <div class="border border-border p-4" data-network="facebook">
            <button
              class="link-btn flex w-full items-center justify-center bg-transparent p-2 font-mono text-sm font-bold uppercase text-foreground"
              data-status="disconnected"
            >
              <svg class="mr-3 size-5" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M23.9981 11.9991C23.9981 5.37216 18.626 0 11.9991 0C5.37216 0 0 5.37216 0 11.9991C0 17.9882 4.38789 22.9522 10.1242 23.8524V15.4676H7.07758V11.9991H10.1242V9.35553C10.1242 6.34826 11.9156 4.68714 14.6564 4.68714C15.9692 4.68714 17.3424 4.92149 17.3424 4.92149V7.87439H15.8294C14.3388 7.87439 13.8739 8.79933 13.8739 9.74824V11.9991H17.2018L16.6698 15.4676H13.8739V23.8524C19.6103 22.9522 23.9981 17.9882 23.9981 11.9991Z"
                ></path>
              </svg>
              <span class="btn-text">Link Facebook Account</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Apps Block -->
      <div class="border border-border p-6">
        <h2 class="border-b border-border pb-3 text-xl font-bold uppercase">
          App Integrations
        </h2>
        <div class="mt-4 space-y-8">
          <!-- Telegram Block -->
          <div class="border border-border p-4" data-app-container="telegram">
            <div
              class="flex items-center justify-between border-b border-border pb-3"
            >
              <h3 class="text-lg font-bold uppercase">Telegram</h3>
              <button
                type="button"
                id="add-telegram-btn"
                class="border border-primary bg-primary px-3 py-1 text-xs font-bold uppercase text-background"
                >+ Add Connection</button
              >
            </div>
            <p class="mt-4 text-xs text-foreground/70">
              Connect multiple bots or channels. Give each connection a unique
              name.
              <a
                href="/faq#telegram-credentials"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary underline">Need help?</a
              >
            </p>
            <form id="telegram-form" class="mt-4">
              <div id="telegram-connections-container" class="space-y-4"></div>
              <div class="mt-6 flex justify-end">
                <button
                  type="submit"
                  class="connect-btn w-full border border-primary bg-primary px-4 py-2 text-sm font-bold uppercase text-background md:w-auto"
                  >Save Telegram Connections</button
                >
              </div>
            </form>
          </div>

          <!-- Discord Block -->
          <div class="border border-border p-4" data-app-container="discord">
            <div
              class="flex items-center justify-between border-b border-border pb-3"
            >
              <h3 class="text-lg font-bold uppercase">Discord</h3>
              <button
                type="button"
                id="add-discord-btn"
                class="border border-primary bg-primary px-3 py-1 text-xs font-bold uppercase text-background"
                >+ Add Connection</button
              >
            </div>
            <p class="mt-4 text-xs text-foreground/70">
              Connect multiple servers or channels via Webhooks. Give each a
              unique name.
              <a
                href="/faq#discord-credentials"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary underline">Need help?</a
              >
            </p>
            <form id="discord-form" class="mt-4">
              <div id="discord-connections-container" class="space-y-4"></div>
              <div class="mt-6 flex justify-end">
                <button
                  type="submit"
                  class="connect-btn w-full border border-primary bg-primary px-4 py-2 text-sm font-bold uppercase text-background md:w-auto"
                  >Save Discord Connections</button
                >
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Modal />
</Layout>

<script>
  import { supabase } from "../../lib/supabase";
  import { showModal, hideModal } from "../../lib/modal";

  interface IConnectionData {
    provider_user_name?: string;
    account_image_url?: string;
  }

  // --- OAUTH UI Update Function ---
  const updateUI = (
    status: "connected" | "disconnected" | "loading",
    button: HTMLButtonElement,
    connectionData: IConnectionData | null,
  ) => {
    const wrapper = button.parentElement as HTMLDivElement;
    if (!wrapper) return;

    const network = wrapper.dataset.network || "unknown";
    const capitalizedNetwork =
      network.charAt(0).toUpperCase() + network.slice(1);
    const originalSVG = wrapper.querySelector("svg")?.outerHTML || "";

    // Clear previous content
    button.innerHTML = "";

    button.disabled = status === "loading";

    if (status === "connected" && connectionData) {
      const userName = connectionData.provider_user_name || "Account";
      const profileImageHTML = connectionData.account_image_url
        ? `<img src="${connectionData.account_image_url}" alt="Profile" class="size-10 rounded-full mr-3 border-2 border-green-500">`
        : originalSVG;

      const profileHTML = `
        <div class="flex items-center text-left w-full">
          ${profileImageHTML}
          <div class="flex flex-col grow ${!connectionData.account_image_url ? "ml-3" : ""}">
            <span class="text-sm font-bold text-foreground">${capitalizedNetwork}: ${userName}</span>
            <span class="text-xs text-green-500">Connected</span>
          </div>
          <button type="button" data-action="unlink" class="text-red-500 hover:underline text-xs font-mono">Unlink</button>
        </div>
      `;
      button.insertAdjacentHTML("beforeend", profileHTML);
      button.classList.remove("justify-center");
      button.classList.add("justify-start");
    } else {
      const linkHTML = `
        ${originalSVG}
        <span class="btn-text">${status === "loading" ? "Loading..." : `Link ${capitalizedNetwork} Account`}</span>
      `;
      button.insertAdjacentHTML("beforeend", linkHTML);
      button.classList.add("justify-center");
      button.classList.remove("justify-start");
    }

    button.dataset.status = status;
    wrapper.classList.remove("border-green-500", "border-border");
    wrapper.classList.add(
      status === "connected" ? "border-green-500" : "border-border",
    );
  };

  // --- OAUTH Main Logic Handler ---
  const handleLinkClick = (event: MouseEvent) => {
    const button = (event.currentTarget as HTMLElement).closest(
      ".link-btn",
    ) as HTMLButtonElement;
    if (!button) return;

    const wrapper = button.parentElement as HTMLDivElement;
    const network = wrapper.dataset.network;
    if (!network) return;

    // Check if the click is on the unlink button inside a connected state
    const isUnlinkAction =
      (event.target as HTMLElement).dataset.action === "unlink";

    if (button.dataset.status === "connected" && isUnlinkAction) {
      const confirmBtnId = `confirm-unlink-${network}`;
      showModal(
        `// Confirm Unlink`,
        `<p class="text-foreground/80">Are you sure you want to unlink your ${network} account?</p>`,
        `<button data-modal-close class="border border-border px-4 py-2 font-mono text-sm uppercase hover:bg-gray-800">Cancel</button>
         <button id="${confirmBtnId}" type="button" class="border border-red-500 bg-red-500 px-4 py-2 font-mono text-sm font-bold uppercase text-white transition-colors hover:bg-red-500/80">Confirm</button>`,
      );
      document.getElementById(confirmBtnId)?.addEventListener("click", () => {
        hideModal();
        performUnlink(network, button);
      });
    } else if (button.dataset.status === "disconnected") {
      performLink(network, button);
    }
  };

  // --- OAUTH Account Linking/Unlinking Functions ---
  const performLink = async (network: string, button: HTMLButtonElement) => {
    updateUI("loading", button, null);
    try {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession();
      if (sessionError || !session)
        throw new Error("User not logged in or session expired.");

      const { data, error } = await supabase.functions.invoke(
        `${network}-auth-start`,
        { body: { userId: session.user.id } },
      );
      if (error) throw error;

      if (data.status === "error") throw new Error(data.error);
      if (!data.authorizationUrl)
        throw new Error("Could not retrieve authorization URL.");

      window.location.href = data.authorizationUrl;
    } catch (error) {
      showModal(
        "// Error",
        `<p class="font-mono text-red-400">${error.message}</p>`,
        `<button data-modal-close class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase text-background">OK</button>`,
      );
      updateUI("disconnected", button, null);
    }
  };

  const performUnlink = async (network: string, button: HTMLButtonElement) => {
    updateUI("loading", button, null);
    try {
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) throw new Error("User not logged in.");

      const { error } = await supabase
        .from("social_connections")
        .delete()
        .match({ user_id: user.id, provider: network });
      if (error) throw error;

      showModal(
        "// Success",
        `<p>${network} account unlinked successfully.</p>`,
        `<button data-modal-close class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase text-background">OK</button>`,
      );
      updateUI("disconnected", button, null);
    } catch (error) {
      showModal(
        "// Error",
        `<p class="font-mono text-red-400">${error.message}</p>`,
        `<button data-modal-close class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase text-background">OK</button>`,
      );
      updateUI("connected", button, null); // Revert to connected on failure
    }
  };

  // --- OAUTH Initial Status Check ---
  const checkInitialStatus = async (button: HTMLButtonElement) => {
    const wrapper = button.parentElement as HTMLDivElement;
    const network = wrapper.dataset.network;
    if (!network) return;

    updateUI("loading", button, null);
    try {
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) {
        updateUI("disconnected", button, null);
        return;
      }

      const { data, error } = await supabase
        .from("social_connections")
        .select("provider_user_name, account_image_url")
        .eq("user_id", user.id)
        .eq("provider", network);

      if (error) {
        console.error(`[DEBUG] Error for ${network}:`, error);
        throw error;
      }

      console.log(`[DEBUG] Data for ${network}:`, data);

      const isConnected = data && data.length > 0;
      const connectionData = isConnected ? data[0] : null;

      updateUI(
        isConnected ? "connected" : "disconnected",
        button,
        connectionData,
      );
    } catch (error) {
      showModal(
        "// Error",
        `<p class="font-mono text-red-400">Error checking ${network} connection status: ${error.message}</p>`,
        `<button data-modal-close class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase text-background">OK</button>`,
      );
      updateUI("disconnected", button, null);
    }
  };

  // --- NEW APP INTEGRATIONS LOGIC ---

  /**
   * Creates the HTML for a single Telegram connection form.
   */
  function createTelegramFormHTML(connection) {
    const uniqueId = connection.id || `new-${Date.now()}`;
    const displayName = connection.provider_user_name || "";
    const botToken = connection.access_token || "";
    const channelId = connection.refresh_token || "";

    return `
      <div class="p-4 space-y-3 border rounded-md border-border/50 connection-form-wrapper" data-connection-id="${uniqueId}">
        <div class="flex items-center justify-end">
            <button type="button" data-action="remove-connection" class="text-red-500 hover:text-red-400">&times; Remove</button>
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium uppercase">Display Name</label>
          <input type="text" value="${displayName}" data-field="display_name" class="w-full border border-border bg-background p-2 text-sm" placeholder="e.g., Project X Announcements" required />
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium uppercase">Bot Token</label>
          <input type="password" value="${botToken}" data-field="bot_token" class="w-full border border-border bg-background p-2 text-sm" placeholder="Enter your bot token" required />
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium uppercase">Channel/Group ID</label>
          <input type="text" value="${channelId}" data-field="channel_id" class="w-full border border-border bg-background p-2 text-sm" placeholder="@channel_username or -100..." required />
        </div>
      </div>
    `;
  }

  /**
   * Creates the HTML for a single Discord connection form.
   */
  function createDiscordFormHTML(connection) {
    const uniqueId = connection.id || `new-${Date.now()}`;
    const displayName = connection.provider_user_name || "";
    const webhookUrl = connection.access_token || "";

    return `
      <div class="p-4 space-y-3 border rounded-md border-border/50 connection-form-wrapper" data-connection-id="${uniqueId}">
        <div class="flex items-center justify-end">
            <button type="button" data-action="remove-connection" class="text-red-500 hover:text-red-400">&times; Remove</button>
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium uppercase">Display Name</label>
          <input type="text" value="${displayName}" data-field="display_name" class="w-full border border-border bg-background p-2 text-sm" placeholder="e.g., General Chat" required />
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium uppercase">Webhook URL</label>
          <input type="password" value="${webhookUrl}" data-field="webhook_url" class="w-full border border-border bg-background p-2 text-sm" placeholder="Enter your Discord Webhook URL" required />
        </div>
      </div>
    `;
  }

  /**
   * Initializes the entire logic for an app integration section (Telegram or Discord).
   */
  async function initializeApp(provider) {
    const appContainer = document.querySelector(
      `[data-app-container="${provider}"]`,
    );
    const form = document.getElementById(`${provider}-form`);
    const container = document.getElementById(
      `${provider}-connections-container`,
    );
    const addButton = document.getElementById(`add-${provider}-btn`);
    const createFormHTML =
      provider === "telegram" ? createTelegramFormHTML : createDiscordFormHTML;

    if (!appContainer || !form || !container || !addButton) return;

    // 1. Fetch existing connections and render them
    try {
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) return; // Should be handled by layout, but good practice

      const { data: connections, error } = await supabase
        .from("social_connections")
        .select("id, provider_user_name, access_token, refresh_token")
        .eq("user_id", user.id)
        .eq("provider", provider);

      if (error) throw error;

      if (connections && connections.length > 0) {
        connections.forEach((conn) =>
          container.insertAdjacentHTML("beforeend", createFormHTML(conn)),
        );
        appContainer.classList.remove("border-border");
        appContainer.classList.add("border-green-500");
      } else {
        container.insertAdjacentHTML("beforeend", createFormHTML({})); // Add one empty form if none exist
        appContainer.classList.remove("border-green-500");
        appContainer.classList.add("border-border");
      }
    } catch (error) {
      console.error(`Error loading ${provider} connections:`, error);
      showModal(
        "// Error",
        `<p>Could not load your ${provider} connections.</p>`,
        `<button data-modal-close>OK</button>`,
      );
      container.innerHTML = `<p class="text-red-500">Error loading connections. Please refresh the page.</p>`;
    }

    // 2. Add new connection button listener
    addButton.addEventListener("click", () => {
      container.insertAdjacentHTML("beforeend", createFormHTML({}));
    });

    // 3. Remove connection button listener (using event delegation)
    container.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target.dataset.action === "remove-connection") {
        target.closest(".connection-form-wrapper")?.remove();
      }
    });

    // 4. Handle form submission to save all connections
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submitButton = form.querySelector(
        ".connect-btn",
      ) as HTMLButtonElement;
      submitButton.disabled = true;
      submitButton.textContent = "Saving...";

      const connectionForms = container.querySelectorAll(
        ".connection-form-wrapper",
      );
      const connectionsData = [];

      try {
        for (const formEl of connectionForms) {
          const displayName = (
            formEl.querySelector(
              '[data-field="display_name"]',
            ) as HTMLInputElement
          ).value;
          if (!displayName) {
            throw new Error("Display Name is required for all connections.");
          }

          if (provider === "telegram") {
            const botToken = (
              formEl.querySelector(
                '[data-field="bot_token"]',
              ) as HTMLInputElement
            ).value;
            const channelId = (
              formEl.querySelector(
                '[data-field="channel_id"]',
              ) as HTMLInputElement
            ).value;
            if (!botToken || !channelId) {
              throw new Error(
                "Bot Token and Channel ID are required for all Telegram connections.",
              );
            }
            connectionsData.push({
              display_name: displayName,
              bot_token: botToken,
              channel_id: channelId,
            });
          } else if (provider === "discord") {
            const webhookUrl = (
              formEl.querySelector(
                '[data-field="webhook_url"]',
              ) as HTMLInputElement
            ).value;
            if (!webhookUrl) {
              throw new Error(
                "Webhook URL is required for all Discord connections.",
              );
            }
            connectionsData.push({
              display_name: displayName,
              webhook_url: webhookUrl,
            });
          }
        }

        const { data, error } = await supabase.functions.invoke(
          "save-app-connection",
          {
            body: { provider: provider, connections: connectionsData },
          },
        );

        if (error || data.status === "error") {
          throw new Error(data.error || error.message);
        }

        showModal(
          "// Success",
          `<p>${provider} connections saved successfully.</p>`,
          `<button data-modal-close class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase text-background">OK</button>`,
        );
        // Reload the page to get fresh state from the server
        setTimeout(() => window.location.reload(), 1500);
      } catch (error) {
        showModal(
          "// Error",
          `<p class="font-mono text-red-400">${error.message}</p>`,
          `<button data-modal-close class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase text-background">OK</button>`,
        );
        submitButton.disabled = false;
        submitButton.textContent = `Save ${provider} Connections`;
      }
    });
  }

  // --- EVENT LISTENERS ---
  document.addEventListener("DOMContentLoaded", () => {
    // OAuth Buttons
    document.querySelectorAll(".link-btn").forEach((button) => {
      button.addEventListener("click", (e) => handleLinkClick(e as MouseEvent));
      checkInitialStatus(button as HTMLButtonElement);
    });

    // Initialize App Integrations
    initializeApp("telegram");
    initializeApp("discord");

    // Modal Global Listeners
    const modalContainer = document.getElementById("modal-container");
    modalContainer?.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).hasAttribute("data-modal-close")) {
        hideModal();
      }
    });
  });
</script>
