---
import Layout from "../../layouts/Layout.astro";
import Modal from "../../components/Modal.astro";
---

<Layout title="Connections // PostPulsar">
  <main class="container py-12">
    <div class="mb-12">
      <h1 class="text-3xl font-bold uppercase">// Posting Connections</h1>
      <p class="mt-1 text-foreground/70">
        Connect your social media accounts to post content directly.
      </p>
    </div>

    <div class="space-y-8">
      <div class="border border-border p-6">
        <h2 class="border-b border-border pb-3 text-xl font-bold uppercase">
          Available Networks
        </h2>
        <div class="mt-4 max-w-sm space-y-6">
          <!-- LinkedIn Block -->
          <div class="border border-border p-4">
            <button
              id="link-linkedin-btn"
              class="link-btn flex w-full items-center justify-center bg-transparent font-mono text-sm font-bold uppercase text-foreground"
              data-network="linkedin"
              data-status="disconnected"
            >
              <svg class="mr-3 size-5" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
                ></path>
              </svg>
              <span class="btn-text">Link LinkedIn Account</span>
            </button>
          </div>

          <!-- Twitter/X Block -->
          <div class="border border-border p-4">
            <button
              id="link-twitter-btn"
              class="link-btn flex w-full items-center justify-center bg-transparent font-mono text-sm font-bold uppercase text-foreground"
              data-network="twitter"
              data-status="disconnected"
            >
              <svg class="mr-3 size-5" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                ></path>
              </svg>
              <span class="btn-text">Link Twitter (X) Account</span>
            </button>
          </div>

          <!-- Instagram Block -->
          <div class="border border-border p-4">
            <button
              id="link-instagram-btn"
              class="link-btn flex w-full items-center justify-center bg-transparent font-mono text-sm font-bold uppercase text-foreground"
              data-network="instagram"
              data-status="disconnected"
            >
              <svg class="mr-3 size-5" viewBox="0 0 16 16" fill="currentColor">
                <path
                  d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z"
                ></path>
              </svg>
              <span class="btn-text">Link Instagram Account</span>
            </button>
          </div>

          <!-- Threads Block -->
          <div class="border border-border p-4">
            <button
              id="link-threads-btn"
              class="link-btn flex w-full items-center justify-center bg-transparent font-mono text-sm font-bold uppercase text-foreground"
              data-network="threads"
              data-status="disconnected"
            >
              <svg class="mr-3 size-5" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M13.358 13.385h-2.717c-.236 0-.428-.19-.428-.428V9.23c0-.237.192-.428.428-.428h2.717c.237 0 .428.19.428.428v3.727c0 .237-.19.428-.428.428m-2.289-1.284h1.86v-2.01h-1.86zM12 24C5.373 24 0 18.627 0 12S5.373 0 12 0s12 5.373 12 12-5.373 12-12 12m0-1.86c5.598 0 10.14-4.542 10.14-10.14S17.598 1.86 12 1.86C6.402 1.86 1.86 6.402 1.86 12s4.542 10.14 10.14 10.14m-4.186-6.095c-.237 0-.428-.19-.428-.428V8.373c0-.237.19-.428.428-.428h.93c.237 0 .428.19.428.428v.93c0 .237-.19.428-.428.428h-.07v3.255c0 .948.768 1.716 1.716 1.716h2.79c.948 0 1.716-.768 1.716-1.716V9.73c0-.237-.19-.428-.428-.428h-.07v-.93c0-.237.19-.428.428-.428h.93c.237 0 .428.19.428.428v7.444c0 .237-.19.428-.428.428h-5.58c-.237 0-.428-.19-.428-.428z"
                ></path>
              </svg>
              <span class="btn-text">Link Threads Account</span>
            </button>
          </div>

          <!-- Facebook Block -->
          <div class="border border-border p-4">
            <button
              id="link-facebook-btn"
              class="link-btn flex w-full items-center justify-center bg-transparent font-mono text-sm font-bold uppercase text-foreground"
              data-network="facebook"
              data-status="disconnected"
            >
              <svg class="mr-3 size-5" viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M23.9981 11.9991C23.9981 5.37216 18.626 0 11.9991 0C5.37216 0 0 5.37216 0 11.9991C0 17.9882 4.38789 22.9522 10.1242 23.8524V15.4676H7.07758V11.9991H10.1242V9.35553C10.1242 6.34826 11.9156 4.68714 14.6564 4.68714C15.9692 4.68714 17.3424 4.92149 17.3424 4.92149V7.87439H15.8294C14.3388 7.87439 13.8739 8.79933 13.8739 9.74824V11.9991H17.2018L16.6698 15.4676H13.8739V23.8524C19.6103 22.9522 23.9981 17.9882 23.9981 11.9991Z"
                ></path>
              </svg>
              <span class="btn-text">Link Facebook Account</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Apps Block -->
      <div class="border border-border p-6">
        <h2 class="border-b border-border pb-3 text-xl font-bold uppercase">
          App Integrations
        </h2>
        <div class="mt-4 space-y-8">
          <!-- Telegram Block -->
          <div class="border border-border p-4" data-app-container="telegram">
            <div class="flex items-center justify-between border-b border-border pb-3">
              <h3 class="text-lg font-bold uppercase">Telegram</h3>
              <button type="button" id="add-telegram-btn" class="border border-primary bg-primary px-3 py-1 text-xs font-bold uppercase text-background">+ Add Connection</button>
            </div>
            <p class="mt-4 text-xs text-foreground/70">
              Connect multiple bots or channels. Give each connection a unique name.
              <a
                href="/faq#telegram-credentials"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary underline"
                >Need help?</a
              >
            </p>
            <form id="telegram-form" class="mt-4">
              <div id="telegram-connections-container" class="space-y-4"></div>
              <div class="mt-6 flex justify-end">
                <button
                  type="submit"
                  class="connect-btn w-full border border-primary bg-primary px-4 py-2 text-sm font-bold uppercase text-background md:w-auto"
                  >Save Telegram Connections</button
                >
              </div>
            </form>
          </div>

          <!-- Discord Block -->
          <div class="border border-border p-4" data-app-container="discord">
            <div class="flex items-center justify-between border-b border-border pb-3">
              <h3 class="text-lg font-bold uppercase">Discord</h3>
              <button type="button" id="add-discord-btn" class="border border-primary bg-primary px-3 py-1 text-xs font-bold uppercase text-background">+ Add Connection</button>
            </div>
            <p class="mt-4 text-xs text-foreground/70">
              Connect multiple servers or channels via Webhooks. Give each a unique name.
              <a
                href="/faq#discord-credentials"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary underline"
                >Need help?</a
              >
            </p>
            <form id="discord-form" class="mt-4">
              <div id="discord-connections-container" class="space-y-4"></div>
              <div class="mt-6 flex justify-end">
                <button
                  type="submit"
                  class="connect-btn w-full border border-primary bg-primary px-4 py-2 text-sm font-bold uppercase text-background md:w-auto"
                  >Save Discord Connections</button
                >
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Modal />
</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  // --- Modal Element References ---
  const modalContainer = document.getElementById("modal-container");
  const modalTitle = document.getElementById("modal-title");
  const modalBody = document.getElementById("modal-body");
  const modalFooter = document.getElementById("modal-footer");
  const modalCloseBtn = document.getElementById("modal-close-btn");

  // --- Generic Modal Functions ---
  function showModal(title, body, footer) {
    if (!modalContainer || !modalTitle || !modalBody || !modalFooter) return;
    modalTitle.innerHTML = title;
    modalBody.innerHTML = body;
    modalFooter.innerHTML = footer;
    modalContainer.classList.remove("hidden");
    modalContainer.classList.add("flex");
  }

  function hideModal() {
    if (!modalContainer) return;
    modalContainer.classList.add("hidden");
    modalContainer.classList.remove("flex");
  }

  // --- OAUTH UI Update Function (Unchanged) ---
  const updateUI = (
    status: "connected" | "disconnected" | "loading",
    button: HTMLButtonElement,
  ) => {
    const wrapper = button.parentElement as HTMLDivElement;
    const btnText = button.querySelector(".btn-text") as HTMLSpanElement;
    if (!btnText || !wrapper) return;

    const networkName = button.dataset.network || "Unknown Network";
    const capitalizedNetwork =
      networkName.charAt(0).toUpperCase() + networkName.slice(1);

    button.disabled = status === "loading";
    btnText.textContent =
      status === "loading"
        ? "Loading..."
        : status === "connected"
          ? `Unlink ${capitalizedNetwork} Account`
          : `Link ${capitalizedNetwork} Account`;
    button.dataset.status = status;

    wrapper.classList.remove("border-green-500", "border-border");

    if (status === "connected") {
      wrapper.classList.add("border-green-500");
    } else {
      wrapper.classList.add("border-border");
    }
  };

  // --- OAUTH Main Logic Handler (Unchanged) ---
  const handleLinkClick = (button: HTMLButtonElement) => {
    const status = button.dataset.status;
    const network = button.dataset.network;
    if (!network) return;

    if (status === "connected") {
      const confirmBtnId = `confirm-unlink-${network}`;
      showModal(
        `// Confirm Unlink`,
        `<p class="text-foreground/80">Are you sure you want to unlink your ${network} account?</p>`,
        `<button data-modal-close class="border border-border px-4 py-2 font-mono text-sm uppercase hover:bg-gray-800">Cancel</button>
         <button id="${confirmBtnId}" type="button" class="border border-red-500 bg-red-500 px-4 py-2 font-mono text-sm font-bold uppercase text-white transition-colors hover:bg-red-500/80">Confirm</button>`,
      );
      document.getElementById(confirmBtnId)?.addEventListener("click", () => {
        hideModal();
        performUnlink(network, button);
      });
    } else if (status === "disconnected") {
      performLink(network, button);
    }
  };

  // --- OAUTH Account Linking/Unlinking Functions (Unchanged) ---
  const performLink = async (network: string, button: HTMLButtonElement) => {
    updateUI("loading", button);
    try {
      const { data: { session }, error: sessionError } = await supabase.auth.getSession();
      if (sessionError || !session) throw new Error("User not logged in or session expired.");

      const { data, error } = await supabase.functions.invoke(`${network}-auth-start`, { body: { userId: session.user.id } });
      if (error) throw error;

      if (data.status === 'error') throw new Error(data.error);
      if (!data.authorizationUrl) throw new Error("Could not retrieve authorization URL.");
      
      window.location.href = data.authorizationUrl;
    } catch (error) {
      showModal("// Error", `<p class="font-mono text-red-400">${error.message}</p>`, `<button data-modal-close class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase text-background">OK</button>`);
      updateUI("disconnected", button);
    }
  };

  const performUnlink = async (network: string, button: HTMLButtonElement) => {
    updateUI("loading", button);
    try {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) throw new Error("User not logged in.");

      const { error } = await supabase.from("social_connections").delete().match({ user_id: user.id, provider: network });
      if (error) throw error;

      showModal("// Success", `<p>${network} account unlinked successfully.</p>`, `<button data-modal-close class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase text-background">OK</button>`);
      updateUI("disconnected", button);
    } catch (error) {
      showModal("// Error", `<p class="font-mono text-red-400">${error.message}</p>`, `<button data-modal-close class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase text-background">OK</button>`);
      updateUI("connected", button);
    }
  };

  // --- OAUTH Initial Status Check (Unchanged) ---
  const checkInitialStatus = async (button: HTMLButtonElement) => {
    const network = button.dataset.network;
    if (!network) return;

    updateUI("loading", button);
    try {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) {
        updateUI("disconnected", button);
        return;
      }

      const { data, error } = await supabase.from("social_connections").select("id").eq("user_id", user.id).eq("provider", network);
      if (error) throw error;

      updateUI(data && data.length > 0 ? "connected" : "disconnected", button);
    } catch (error) {
      showModal("// Error", `<p class="font-mono text-red-400">Error checking ${network} connection status: ${error.message}</p>`, `<button data-modal-close class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase text-background">OK</button>`);
      updateUI("disconnected", button);
    }
  };

  // --- NEW APP INTEGRATIONS LOGIC ---

  /**
   * Creates the HTML for a single Telegram connection form.
   */
  function createTelegramFormHTML(connection) {
    const uniqueId = connection.id || `new-${Date.now()}`;
    const displayName = connection.provider_user_name || "";
    const botToken = connection.access_token || "";
    const channelId = connection.refresh_token || "";

    return `
      <div class="p-4 space-y-3 border rounded-md border-border/50 connection-form-wrapper" data-connection-id="${uniqueId}">
        <div class="flex items-center justify-end">
            <button type="button" data-action="remove-connection" class="text-red-500 hover:text-red-400">&times; Remove</button>
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium uppercase">Display Name</label>
          <input type="text" value="${displayName}" data-field="display_name" class="w-full border border-border bg-background p-2 text-sm" placeholder="e.g., Project X Announcements" required />
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium uppercase">Bot Token</label>
          <input type="password" value="${botToken}" data-field="bot_token" class="w-full border border-border bg-background p-2 text-sm" placeholder="Enter your bot token" required />
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium uppercase">Channel/Group ID</label>
          <input type="text" value="${channelId}" data-field="channel_id" class="w-full border border-border bg-background p-2 text-sm" placeholder="@channel_username or -100..." required />
        </div>
      </div>
    `;
  }

  /**
   * Creates the HTML for a single Discord connection form.
   */
  function createDiscordFormHTML(connection) {
    const uniqueId = connection.id || `new-${Date.now()}`;
    const displayName = connection.provider_user_name || "";
    const webhookUrl = connection.access_token || "";

    return `
      <div class="p-4 space-y-3 border rounded-md border-border/50 connection-form-wrapper" data-connection-id="${uniqueId}">
        <div class="flex items-center justify-end">
            <button type="button" data-action="remove-connection" class="text-red-500 hover:text-red-400">&times; Remove</button>
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium uppercase">Display Name</label>
          <input type="text" value="${displayName}" data-field="display_name" class="w-full border border-border bg-background p-2 text-sm" placeholder="e.g., General Chat" required />
        </div>
        <div>
          <label class="mb-1 block text-xs font-medium uppercase">Webhook URL</label>
          <input type="password" value="${webhookUrl}" data-field="webhook_url" class="w-full border border-border bg-background p-2 text-sm" placeholder="Enter your Discord Webhook URL" required />
        </div>
      </div>
    `;
  }

  /**
   * Initializes the entire logic for an app integration section (Telegram or Discord).
   */
  async function initializeApp(provider) {
    const appContainer = document.querySelector(`[data-app-container="${provider}"]`);
    const form = document.getElementById(`${provider}-form`);
    const container = document.getElementById(`${provider}-connections-container`);
    const addButton = document.getElementById(`add-${provider}-btn`);
    const createFormHTML = provider === 'telegram' ? createTelegramFormHTML : createDiscordFormHTML;

    if (!appContainer || !form || !container || !addButton) return;

    // 1. Fetch existing connections and render them
    try {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) return; // Should be handled by layout, but good practice

      const { data: connections, error } = await supabase
        .from("social_connections")
        .select("id, provider_user_name, access_token, refresh_token")
        .eq("user_id", user.id)
        .eq("provider", provider);

      if (error) throw error;

      if (connections && connections.length > 0) {
        connections.forEach(conn => container.insertAdjacentHTML('beforeend', createFormHTML(conn)));
        appContainer.classList.remove("border-border");
        appContainer.classList.add("border-green-500");
      } else {
        container.insertAdjacentHTML('beforeend', createFormHTML({})); // Add one empty form if none exist
        appContainer.classList.remove("border-green-500");
        appContainer.classList.add("border-border");
      }
    } catch (error) {
        console.error(`Error loading ${provider} connections:`, error);
        showModal("// Error", `<p>Could not load your ${provider} connections.</p>`, `<button data-modal-close>OK</button>`);
        container.innerHTML = `<p class="text-red-500">Error loading connections. Please refresh the page.</p>`
    }

    // 2. Add new connection button listener
    addButton.addEventListener('click', () => {
      container.insertAdjacentHTML('beforeend', createFormHTML({}));
    });

    // 3. Remove connection button listener (using event delegation)
    container.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.dataset.action === 'remove-connection') {
            target.closest('.connection-form-wrapper')?.remove();
        }
    });

    // 4. Handle form submission to save all connections
    form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const submitButton = form.querySelector('.connect-btn') as HTMLButtonElement;
        submitButton.disabled = true;
        submitButton.textContent = 'Saving...';

        const connectionForms = container.querySelectorAll('.connection-form-wrapper');
        const connectionsData = [];

        try {
            for (const formEl of connectionForms) {
                const displayName = (formEl.querySelector('[data-field="display_name"]') as HTMLInputElement).value;
                if (!displayName) {
                    throw new Error('Display Name is required for all connections.');
                }

                if (provider === 'telegram') {
                    const botToken = (formEl.querySelector('[data-field="bot_token"]') as HTMLInputElement).value;
                    const channelId = (formEl.querySelector('[data-field="channel_id"]') as HTMLInputElement).value;
                    if (!botToken || !channelId) {
                        throw new Error('Bot Token and Channel ID are required for all Telegram connections.');
                    }
                    connectionsData.push({ display_name: displayName, bot_token: botToken, channel_id: channelId });
                } else if (provider === 'discord') {
                    const webhookUrl = (formEl.querySelector('[data-field="webhook_url"]') as HTMLInputElement).value;
                    if (!webhookUrl) {
                        throw new Error('Webhook URL is required for all Discord connections.');
                    }
                    connectionsData.push({ display_name: displayName, webhook_url: webhookUrl });
                }
            }

            const { data, error } = await supabase.functions.invoke("save-app-connection", {
                body: { provider: provider, connections: connectionsData },
            });

            if (error || data.status === 'error') {
                throw new Error(data.error || error.message);
            }

            showModal("// Success", `<p>${provider} connections saved successfully.</p>`, `<button data-modal-close class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase text-background">OK</button>`);
            // Reload the page to get fresh state from the server
            setTimeout(() => window.location.reload(), 1500);

        } catch (error) {
            showModal("// Error", `<p class="font-mono text-red-400">${error.message}</p>`, `<button data-modal-close class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase text-background">OK</button>`);
            submitButton.disabled = false;
            submitButton.textContent = `Save ${provider} Connections`;
        }
    });
  }


  // --- EVENT LISTENERS ---
  document.addEventListener("DOMContentLoaded", () => {
    // OAuth Buttons
    document.querySelectorAll(".link-btn").forEach((button) => {
      button.addEventListener("click", () =>
        handleLinkClick(button as HTMLButtonElement),
      );
      checkInitialStatus(button as HTMLButtonElement);
    });

    // Initialize App Integrations
    initializeApp("telegram");
    initializeApp("discord");

    // Modal Global Listeners
    modalCloseBtn?.addEventListener("click", hideModal);
    modalContainer?.addEventListener("click", (e) => {
      if (e.target === modalContainer) {
        hideModal();
      }
    });
  });
</script>