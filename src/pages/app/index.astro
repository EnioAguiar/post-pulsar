--- 
import Layout from "../../layouts/Layout.astro";
import LanguageSelector from "../../components/LanguageSelector.astro";
import Modal from "../../components/Modal.astro";
---

<Layout title="Dashboard // PostPulsar">
  <main class="container py-12">
    <div class="flex items-start justify-between">
      <div>
        <h1 id="welcome-message" class="text-3xl font-bold uppercase">
          // Mission Control
        </h1>
        <p class="mt-2 text-foreground/70">
          System ready. Paste the article URL to begin transmission.
        </p>
      </div>
      <div class="text-right font-mono">
        <p class="text-sm uppercase text-foreground/70">Pulse Balance</p>
        <p id="pulse-count-display" class="text-3xl font-bold">--</p>
      </div>
    </div>

    <div class="mt-8">
      <form id="pulsar-form">
        <div class="mb-4">
            <label for="post-url" class="mb-2 block font-mono text-sm uppercase text-foreground/70">// Article URL</label>
            <input
              type="url"
              id="post-url"
              name="post-url"
              required
              class="w-full rounded-none border border-border bg-background p-4 font-mono text-lg focus:border-primary focus:outline-none focus:ring-0"
              placeholder="https://your-blog.com/your-awesome-article"
            />
        </div>

        <!-- Advanced Settings Accordion -->
        <div class="mt-4">
          <button type="button" id="advanced-settings-toggle" class="font-mono text-sm uppercase text-foreground/70 hover:text-primary">
            &gt; Advanced Settings
          </button>
          <div id="advanced-settings-panel" class="hidden mt-4 border border-border/50 p-4">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              <div>
                <label for="linkedin-char-count" class="mb-2 block font-mono text-sm uppercase text-foreground/70">// Approx. Chars (LinkedIn)</label>
                <input type="number" id="linkedin-char-count" name="linkedin-char-count" class="w-full rounded-none border border-border bg-background p-4 font-mono text-lg focus:border-primary focus:outline-none focus:ring-0" placeholder="(e.g., 800)">
              </div>
              <div>
                <label for="twitter-char-count" class="mb-2 block font-mono text-sm uppercase text-foreground/70">// Approx. Chars (X)</label>
                <input type="number" id="twitter-char-count" name="twitter-char-count" class="w-full rounded-none border border-border bg-background p-4 font-mono text-lg focus:border-primary focus:outline-none focus:ring-0" placeholder="(e.g., 250)">
              </div>
              <div>
                <label for="instagram-char-count" class="mb-2 block font-mono text-sm uppercase text-foreground/70">// Approx. Chars (Instagram)</label>
                <input type="number" id="instagram-char-count" name="instagram-char-count" class="w-full rounded-none border border-border bg-background p-4 font-mono text-lg focus:border-primary focus:outline-none focus:ring-0" placeholder="(e.g., 400)">
              </div>
              <div class="flex items-end md:col-span-2 lg:col-span-3">
                <button type="button" id="save-prefs-btn" class="w-full border border-primary bg-primary px-8 py-4 font-mono text-lg font-bold uppercase text-background transition-colors hover:bg-primary/80 disabled:cursor-not-allowed disabled:bg-gray-500">Save as Default</button>
              </div>
            </div>
          </div>
        </div>

        <div class="flex items-end gap-4 mt-4">
          <LanguageSelector id="content-language" name="content-language" labelText="// Content Language" defaultValue="English" />
          <LanguageSelector id="hashtag-language" name="hashtag-language" labelText="// Hashtag Language" defaultValue="English" />
          <button
            type="submit"
            class="border border-primary bg-primary px-8 py-4 font-mono text-lg font-bold uppercase text-background transition-colors hover:bg-primary/80 disabled:cursor-not-allowed disabled:bg-gray-500"
            >Pulsar &gt;&gt;</button
          >
        </div>
      </form>
    </div>

    <!-- Future content area -->
    <div id="content-output" class="mt-12"></div>
  </main>
  <Modal />
</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  // Page elements
  const pulseCountDisplay = document.getElementById("pulse-count-display");
  const pulsarForm = document.getElementById("pulsar-form");
  const outputArea = document.getElementById("content-output");
  const urlInput = document.getElementById("post-url") as HTMLInputElement;
  const contentLanguageInput = document.getElementById(
    "content-language",
  ) as HTMLInputElement;
  const hashtagLanguageInput = document.getElementById(
    "hashtag-language",
  ) as HTMLInputElement;
  const submitButton = pulsarForm?.querySelector("button[type='submit']");

  // Advanced Settings elements
  const advancedSettingsToggle = document.getElementById("advanced-settings-toggle");
  const advancedSettingsPanel = document.getElementById("advanced-settings-panel");
  const linkedinCharCountInput = document.getElementById("linkedin-char-count") as HTMLInputElement;
  const twitterCharCountInput = document.getElementById("twitter-char-count") as HTMLInputElement;
  const instagramCharCountInput = document.getElementById("instagram-char-count") as HTMLInputElement;
  const savePrefsBtn = document.getElementById("save-prefs-btn");

  // Modal elements
  const modalContainer = document.getElementById("modal-container");
  const modalTitle = document.getElementById("modal-title");
  const modalBody = document.getElementById("modal-body");
  const modalFooter = document.getElementById("modal-footer");
  const modalCloseBtn = document.getElementById("modal-close-btn");

  let currentPulseCount = 0;
  let instagramImageUrl: string | null = null;
  let userId: string | null = null;

  // --- Modal Logic ---
  function showModal(title, body, footer) {
    if (!modalContainer || !modalTitle || !modalBody || !modalFooter) return;
    modalTitle.innerHTML = title;
    modalBody.innerHTML = body;
    modalFooter.innerHTML = footer;
    modalContainer.classList.remove("hidden");
  }

  function hideModal() {
    if (!modalContainer) return;
    modalContainer.classList.add("hidden");
  }

  // Fetch user session and profile data on page load
  async function loadUserData() {
    const {
      data: { session },
      error: sessionError,
    } = await supabase.auth.getSession();
    if (sessionError || !session) {
      window.location.href = "/login";
      return;
    }
    userId = session.user.id; // Store user ID

    const { data: profile, error: profileError } = await supabase
      .from("profiles")
      .select("monthly_pulses_remaining, default_linkedin_chars, default_twitter_chars, default_instagram_chars")
      .eq("id", session.user.id)
      .single();

    if (profileError || !profile) {
      console.error("Error fetching profile:", profileError);
      if (pulseCountDisplay) pulseCountDisplay.innerText = "Error";
      return;
    }

    currentPulseCount = profile.monthly_pulses_remaining;
    updatePulseDisplay(currentPulseCount);

    // Populate advanced settings fields with saved preferences
    if (profile.default_linkedin_chars) {
      linkedinCharCountInput.value = profile.default_linkedin_chars;
    }
    if (profile.default_twitter_chars) {
      twitterCharCountInput.value = profile.default_twitter_chars;
    }
    if (profile.default_instagram_chars) {
      instagramCharCountInput.value = profile.default_instagram_chars;
    }
  }

  function updatePulseDisplay(count) {
    if (pulseCountDisplay) {
      pulseCountDisplay.innerText = count === -1 ? "∞" : count.toString();
    }
  }

  // Handle the form submission to generate content
  async function handlePulsarSubmit(e) {
    e.preventDefault();
    instagramImageUrl = null; // Reset image on new generation

    if (!submitButton || !outputArea) return;

    submitButton.setAttribute("disabled", "true");
    submitButton.innerHTML = "PULSING...";
    outputArea.innerHTML = `<div class="border border-dashed border-border p-8 text-center"><p class="font-mono text-foreground/70">[PULSING] :: Transmitting signal...</p></div>`;

    try {
      const bodyPayload: { [key: string]: any } = {
        url: urlInput.value,
        contentLanguage: contentLanguageInput.value,
        hashtagLanguage: hashtagLanguageInput.value,
      };

      if (linkedinCharCountInput.value) {
        bodyPayload.linkedInCharCount = parseInt(linkedinCharCountInput.value, 10);
      }
      if (twitterCharCountInput.value) {
        bodyPayload.twitterCharCount = parseInt(twitterCharCountInput.value, 10);
      }
      if (instagramCharCountInput.value) {
        bodyPayload.instagramCharCount = parseInt(instagramCharCountInput.value, 10);
      }

      const { data, error } = await supabase.functions.invoke("pulsar-v1", {
        body: bodyPayload,
      });

      if (error) throw error;

      currentPulseCount--;
      updatePulseDisplay(currentPulseCount);

      const { generatedContent, postId } = data;

      outputArea.innerHTML = `
        <h2 class="text-2xl font-bold uppercase">// Transmission Received</h2>
        <div class="mt-4 space-y-6">
          <!-- LinkedIn Post -->
          ${generatedContent.linkedIn ? `
          <div>
            <h3 class="font-mono text-lg text-foreground/80">// LinkedIn Post</h3>
            <div class="relative mt-2">
              <textarea class="h-48 w-full rounded-none border border-border bg-background p-4 font-mono text-base focus:border-primary focus:outline-none focus:ring-0">${generatedContent.linkedIn}</textarea>
              <div class="mt-2 flex gap-2">
                <button class="publish-btn border border-border px-4 py-2 font-mono text-sm uppercase hover:bg-primary hover:text-background disabled:cursor-not-allowed disabled:bg-gray-500" data-network="linkedin">Post to LinkedIn</button>
                <button class="copy-btn border border-border px-4 py-2 font-mono text-sm uppercase hover:bg-primary hover:text-background">Copy Text</button>
              </div>
            </div>
          </div>
          ` : ''}

          <!-- Twitter/X Post -->
          ${generatedContent.twitter ? `
          <div>
            <h3 class="font-mono text-lg text-foreground/80">// X (Twitter) Post</h3>
            <div class="relative mt-2">
              <textarea class="h-32 w-full rounded-none border border-border bg-background p-4 font-mono text-base focus:border-primary focus:outline-none focus:ring-0">${generatedContent.twitter}</textarea>
              <div class="mt-2 flex gap-2">
                <button class="publish-btn border border-border px-4 py-2 font-mono text-sm uppercase hover:bg-primary hover:text-background disabled:cursor-not-allowed disabled:bg-gray-500" data-network="twitter">Post to X</button>
                <button class="copy-btn border border-border px-4 py-2 font-mono text-sm uppercase hover:bg-primary hover:text-background">Copy Text</button>
              </div>
            </div>
          </div>
          ` : ''}

          <!-- Instagram Post -->
          ${generatedContent.instagram ? `
          <div id="instagram-post-area">
            <h3 class="font-mono text-lg text-foreground/80">// Instagram Post</h3>
            <div class="relative mt-2">
              <!-- Image Upload -->
              <div class="mb-4">
                <label for="instagram-image-upload" class="mb-2 block font-mono text-sm uppercase text-foreground/70">// Upload Image (Optional)</label>
                <input type="file" id="instagram-image-upload" accept="image/jpeg,image/png,image/webp" class="w-full rounded-none border border-border bg-background p-4 font-mono text-sm">
                <div id="instagram-image-preview-container" class="mt-2 hidden">
                  <img id="instagram-image-preview" src="#" alt="Image Preview" class="max-h-40 border border-border"/>
                  <p id="instagram-upload-status" class="font-mono text-sm text-foreground/70 mt-1"></p>
                </div>
              </div>
              <textarea class="h-40 w-full rounded-none border border-border bg-background p-4 font-mono text-base focus:border-primary focus:outline-none focus:ring-0">${generatedContent.instagram}</textarea>
              <div class="mt-2 flex gap-2">
                <button class="publish-btn border border-border px-4 py-2 font-mono text-sm uppercase hover:bg-primary hover:text-background disabled:cursor-not-allowed disabled:bg-gray-500" data-network="instagram">Post to Instagram</button>
                <button class="copy-btn border border-border px-4 py-2 font-mono text-sm uppercase hover:bg-primary hover:text-background">Copy Text</button>
              </div>
            </div>
          </div>
          ` : ''}
        </div>
      `;
    } catch (error) {
      outputArea.innerHTML = `<div class="border border-red-500/50 p-8 text-center"><p class="font-mono font-bold text-red-400">[ERROR]</p><p class="font-mono text-foreground/70 mt-2">${error.message}</p></div>`;
    } finally {
      submitButton.removeAttribute("disabled");
      submitButton.innerHTML = "Pulsar &gt;&gt;";
    }
  }

  async function handleSavePrefs() {
    const linkedInChars = parseInt(linkedinCharCountInput.value, 10) || null;
    const twitterChars = parseInt(twitterCharCountInput.value, 10) || null;
    const instagramChars = parseInt(instagramCharCountInput.value, 10) || null;

    savePrefsBtn.setAttribute("disabled", "true");
    savePrefsBtn.innerText = "Saving...";

    try {
      const { error } = await supabase.rpc("update_char_preferences", {
        linkedin_chars: linkedInChars,
        twitter_chars: twitterChars,
        instagram_chars: instagramChars,
      });

      if (error) throw error;

      savePrefsBtn.innerText = "Saved!";
      setTimeout(() => {
        savePrefsBtn.innerText = "Save as Default";
        savePrefsBtn.removeAttribute("disabled");
      }, 2000);

    } catch (error) {
      alert(`Error saving preferences: ${error.message}`);
      savePrefsBtn.innerText = "Save as Default";
      savePrefsBtn.removeAttribute("disabled");
    }
  }

  async function handleImageUpload(e) {
    const target = e.target as HTMLElement;

    if (target.id === 'instagram-image-upload') {
        const fileInput = target as HTMLInputElement;
        const file = fileInput.files ? fileInput.files[0] : null;
        
        const previewContainer = document.getElementById('instagram-image-preview-container') as HTMLDivElement;
        const previewImage = document.getElementById('instagram-image-preview') as HTMLImageElement;
        const uploadStatus = document.getElementById('instagram-upload-status') as HTMLParagraphElement;

        if (!file || !previewContainer || !previewImage || !uploadStatus) return;

        if (!userId) {
            console.error("User ID is not available for upload.");
            uploadStatus.textContent = "Error: Authentication issue. Please refresh.";
            return;
        }

        if (!['image/jpeg', 'image/png'].includes(file.type)) {
            uploadStatus.textContent = "Error: Only JPG or PNG are allowed.";
            uploadStatus.classList.add('text-red-400');
            return;
        }

        previewContainer.classList.remove('hidden');
        uploadStatus.textContent = "Uploading...";
        uploadStatus.classList.remove('text-red-400');
        
        try {
            const filePath = `public/${userId}/${Date.now()}_${file.name}`;
            const { error: uploadError } = await supabase.storage
                .from('post-images')
                .upload(filePath, file);

            if (uploadError) throw uploadError;

            const { data: publicUrlData } = supabase.storage
                .from('post-images')
                .getPublicUrl(filePath);

            if (!publicUrlData) throw new Error("Could not get public URL.");

            instagramImageUrl = publicUrlData.publicUrl;
            previewImage.src = instagramImageUrl;
            uploadStatus.textContent = "Upload complete.";

        } catch (error) {
            console.error("Upload failed:", error);
            uploadStatus.textContent = `Error: ${error.message}`;
            uploadStatus.classList.add('text-red-400');
            instagramImageUrl = null;
        }
    }
  }

  // Handle clicks on dynamically created buttons
  async function handleOutputAreaClick(e) {
    const target = e.target as HTMLElement;

    if (target.classList.contains("copy-btn")) {
      const content = target.closest(".relative").querySelector("textarea").value;
      navigator.clipboard.writeText(content);
      target.innerText = "Copied!";
      setTimeout(() => { target.innerText = "Copy Text"; }, 2000);
    }

    if (target.classList.contains("publish-btn")) {
      const network = target.dataset.network;
      const editedText = target.closest(".relative").querySelector("textarea").value;

      if (!editedText) {
        alert("Cannot publish empty content.");
        return;
      }

      const confirmButtonId = "confirm-publish-btn";
      showModal(
        "// Confirm Publication",
        `<p class="text-foreground/80">Are you sure you want to post this content to ${network}? This will consume 1 Pulse.</p>`,
        `<button id="cancel-publish-btn" class="border border-border px-4 py-2 font-mono text-sm uppercase hover:bg-gray-800">Cancel</button>
         <button id="${confirmButtonId}" class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase text-background">Confirm & Post</button>`
      );

      document.getElementById(confirmButtonId)?.addEventListener("click", async () => {
          hideModal();
          target.setAttribute("disabled", "true");
          target.innerText = "Publishing...";

          try {
            const body: { network: string; text: string; imageUrl?: string } = {
              network,
              text: editedText,
            };

            if (network === 'instagram' && instagramImageUrl) {
              body.imageUrl = instagramImageUrl;
            }

            const { error } = await supabase.functions.invoke("publish-to-social", {
              body: body,
            });

            if (error) throw error;

            currentPulseCount--;
            updatePulseDisplay(currentPulseCount);
            target.innerText = `Published to ${network}!`;
          } catch (error) {
            target.innerText = `Error!`;
            target.removeAttribute("disabled");
            showModal(
              "// Publication Failed",
              `<p class="font-mono text-red-400">${error.message}</p>`,
              `<button id="error-ok-btn" class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase">OK</button>`
            );
            document.getElementById("error-ok-btn")?.addEventListener("click", hideModal);
          }
        });

      document.getElementById("cancel-publish-btn")?.addEventListener("click", hideModal);
    }
  }

  // Initial setup
  if (pulsarForm && outputArea && submitButton) {
    pulsarForm.addEventListener("submit", handlePulsarSubmit);
    outputArea.addEventListener("click", handleOutputAreaClick);
    outputArea.addEventListener("change", handleImageUpload);
    loadUserData();

    advancedSettingsToggle.addEventListener("click", () => {
      advancedSettingsPanel.classList.toggle("hidden");
    });

    savePrefsBtn.addEventListener("click", handleSavePrefs);
  }

  modalCloseBtn?.addEventListener("click", hideModal);
  modalContainer?.addEventListener("click", (e) => {
    if (e.target === modalContainer) {
      hideModal();
    }
  });
</script>