---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Dashboard // PostPulsar">
  <main class="container py-12">
    <div id="welcome-container">
      <h1 id="welcome-message" class="text-3xl font-bold uppercase">
        // Mission Control
      </h1>
      <p class="mt-2 text-foreground/70">
        System ready. Paste the article URL to begin transmission.
      </p>
    </div>

    <div class="mt-8">
      <form id="pulsar-form">
        <div class="flex items-stretch gap-4">
          <div class="flex-grow flex gap-4">
            <input
              type="url"
              id="post-url"
              name="post-url"
              required
              class="w-full rounded-none border border-border bg-background p-4 font-mono text-lg focus:border-primary focus:outline-none focus:ring-0"
              placeholder="https://your-blog.com/your-awesome-article"
            />
            <select
              id="output-language"
              name="output-language"
              class="rounded-none border border-border bg-background p-4 font-mono text-lg focus:border-primary focus:outline-none focus:ring-0"
            >
              <option value="English" selected>English</option>
              <option value="Portuguese">Portuguese</option>
              <option value="Spanish">Spanish</option>
            </select>
          </div>
          <button
            type="submit"
            class="border border-primary bg-primary px-8 py-4 font-mono text-lg font-bold uppercase text-background transition-colors hover:bg-primary/80"
            >Pulsar &gt;&gt;</button
          >
        </div>
      </form>
    </div>

    <!-- Future content area -->
    <div id="content-output" class="mt-12"></div>
  </main>
</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  // Check session on page load
  async function checkSession() {
    const { data, error } = await supabase.auth.getSession();
    if (error || !data.session) {
      window.location.href = "/login";
    }
  }
  checkSession();

  // Handle form submission
  const pulsarForm = document.getElementById("pulsar-form");
  const outputArea = document.getElementById("content-output");
  const urlInput = document.getElementById("post-url") as HTMLInputElement;
  const languageSelect = document.getElementById("output-language") as HTMLSelectElement;
  const submitButton = pulsarForm?.querySelector("button[type='submit']");

  if (pulsarForm && outputArea && urlInput && languageSelect && submitButton) {
    pulsarForm.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Disable form and show loading state
      submitButton.setAttribute("disabled", "true");
      submitButton.innerHTML = "PULSING...";
      outputArea.innerHTML = `
        <div class="border border-dashed border-border p-8 text-center">
          <p class="font-mono text-foreground/70">[PULSING] :: Transmitting signal to URL: ${urlInput.value}</p>
          <p class="font-mono text-foreground/70 mt-2">[AWAITING_RESPONSE]...</p>
        </div>
      `;

      try {
        // Invoke the Supabase Edge Function
        const { data, error } = await supabase.functions.invoke("pulsar-v1", {
          body: { 
            url: urlInput.value,
            language: languageSelect.value 
          },
        });

        if (error) {
          throw error;
        }

        // Display success
        // The 'data' from the function is the generated post string.
        const generatedPost = data.data; 

        outputArea.innerHTML = `
          <h2 class="text-2xl font-bold uppercase">// AI-Generated Post (LinkedIn)</h2>
          <div class="relative mt-4">
            <button id="copy-button" class="absolute top-2 right-2 bg-background/50 border border-border px-2 py-1 font-mono text-xs uppercase hover:bg-primary hover:text-background">Copy</button>
            <div id="post-content" class="whitespace-pre-wrap rounded-none border border-border bg-background p-4 font-mono text-base">${generatedPost}</div>
          </div>
        `;

        // Add event listener for the new copy button
        const copyButton = document.getElementById('copy-button');
        const postContent = document.getElementById('post-content');
        if (copyButton && postContent) {
          copyButton.addEventListener('click', () => {
            navigator.clipboard.writeText(postContent.innerText);
            copyButton.innerText = 'Copied!';
            setTimeout(() => {
              copyButton.innerText = 'Copy';
            }, 2000);
          });
        }
      } catch (error) {
        // Display error
        outputArea.innerHTML = `
          <div class="border border-red-500/50 p-8 text-center">
            <p class="font-mono font-bold text-red-400">[TRANSMISSION_ERROR]</p>
            <p class="font-mono text-foreground/70 mt-2">${error.message}</p>
          </div>
        `;
      } finally {
        // Re-enable form
        submitButton.removeAttribute("disabled");
        submitButton.innerHTML = "Pulsar &gt;&gt;";
      }
    });
  }
</script>
