---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Dashboard | PostPulsar">
  <main class="bg-gray-100 min-h-screen">
    <div class="container mx-auto px-6 py-12">
      <h1 id="welcome-message" class="text-4xl font-bold text-gray-800">
        Welcome to Your Dashboard
      </h1>
      <p class="mt-2 text-gray-600">
        Here you can manage your posts and much more.
      </p>

      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <!-- Placeholder Card 1 -->
        <div class="bg-white p-6 rounded-lg shadow-lg">
          <h3 class="text-xl font-bold text-gray-800">Create New Post</h3>
          <p class="mt-2 text-gray-600">
            Start creating a new post for your social networks.
          </p>
          <button
            class="mt-4 bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg"
            >Create Now</button
          >
        </div>

        <!-- Placeholder Card 2 -->
        <div class="bg-white p-6 rounded-lg shadow-lg">
          <h3 class="text-xl font-bold text-gray-800">View Previous Posts</h3>
          <p class="mt-2 text-gray-600">
            Access the history of all the posts you have created.
          </p>
          <button
            class="mt-4 bg-gray-700 hover:bg-gray-800 text-white font-bold py-2 px-4 rounded-lg"
            >View History</button
          >
        </div>

        <!-- Placeholder Card 3 -->
        <div class="bg-white p-6 rounded-lg shadow-lg">
          <h3 class="text-xl font-bold text-gray-800">Account Settings</h3>
          <p class="mt-2 text-gray-600">
            Manage your profile information and settings.
          </p>
          <a
            href="/app/settings"
            class="mt-4 inline-block bg-gray-700 hover:bg-gray-800 text-white font-bold py-2 px-4 rounded-lg text-center"
            >Go to Settings</a
          >
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  // Check session on page load and personalize message
  async function checkSession() {
    const { data, error } = await supabase.auth.getSession();
    if (error || !data.session) {
      window.location.href = "/login";
      return;
    }

    const user = data.session.user;
    const welcomeMessage = document.getElementById("welcome-message");
    if (welcomeMessage && user.email) {
      welcomeMessage.textContent = `Welcome, ${user.email}!`;
    }
  }

  checkSession();
</script>
