--- 
import Layout from "../../layouts/Layout.astro";
import LanguageSelector from "../../components/LanguageSelector.astro";
import Modal from "../../components/Modal.astro";
---

<Layout title="Dashboard // PostPulsar">
  <main class="container py-12">
    <div class="flex items-start justify-between">
      <div>
        <h1 id="welcome-message" class="text-3xl font-bold uppercase">
          // Mission Control
        </h1>
        <p class="mt-2 text-foreground/70">
          System ready. Paste the article URL to begin transmission.
        </p>
      </div>
      <div class="text-right font-mono">
        <p class="text-sm uppercase text-foreground/70">Pulse Balance</p>
        <p id="pulse-count-display" class="text-3xl font-bold">--</p>
      </div>
    </div>

    <div class="mt-8">
      <form id="pulsar-form">
        <div class="mb-4">
            <label for="post-url" class="mb-2 block font-mono text-sm uppercase text-foreground/70">// Article URL</label>
            <input
              type="url"
              id="post-url"
              name="post-url"
              required
              class="w-full rounded-none border border-border bg-background p-4 font-mono text-lg focus:border-primary focus:outline-none focus:ring-0"
              placeholder="https://your-blog.com/your-awesome-article"
            />
        </div>
        <div class="flex items-end gap-4">
          <LanguageSelector id="content-language" name="content-language" labelText="// Content Language" defaultValue="English" />
          <LanguageSelector id="hashtag-language" name="hashtag-language" labelText="// Hashtag Language" defaultValue="English" />
          <button
            type="submit"
            class="border border-primary bg-primary px-8 py-4 font-mono text-lg font-bold uppercase text-background transition-colors hover:bg-primary/80 disabled:cursor-not-allowed disabled:bg-gray-500"
            >Pulsar &gt;&gt;</button
          >
        </div>
      </form>
    </div>

    <!-- Future content area -->
    <div id="content-output" class="mt-12"></div>
  </main>
  <Modal />
</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  // Page elements
  const pulseCountDisplay = document.getElementById("pulse-count-display");
  const pulsarForm = document.getElementById("pulsar-form");
  const outputArea = document.getElementById("content-output");
  const urlInput = document.getElementById("post-url") as HTMLInputElement;
  const contentLanguageInput = document.getElementById(
    "content-language",
  ) as HTMLInputElement;
  const hashtagLanguageInput = document.getElementById(
    "hashtag-language",
  ) as HTMLInputElement;
  const submitButton = pulsarForm?.querySelector("button[type='submit']");

  // Modal elements
  const modalContainer = document.getElementById("modal-container");
  const modalTitle = document.getElementById("modal-title");
  const modalBody = document.getElementById("modal-body");
  const modalFooter = document.getElementById("modal-footer");
  const modalCloseBtn = document.getElementById("modal-close-btn");

  let currentPulseCount = 0;

  // --- Modal Logic ---
  function showModal(title, body, footer) {
    if (!modalContainer || !modalTitle || !modalBody || !modalFooter) return;
    modalTitle.innerHTML = title;
    modalBody.innerHTML = body;
    modalFooter.innerHTML = footer;
    modalContainer.classList.remove("hidden");
  }

  function hideModal() {
    if (!modalContainer) return;
    modalContainer.classList.add("hidden");
  }

  // Fetch user session and profile data on page load
  async function loadUserData() {
    const {
      data: { session },
      error: sessionError,
    } = await supabase.auth.getSession();
    if (sessionError || !session) {
      window.location.href = "/login";
      return;
    }

    const { data: profile, error: profileError } = await supabase
      .from("profiles")
      .select("monthly_pulses_remaining")
      .eq("id", session.user.id)
      .single();

    if (profileError || !profile) {
      console.error("Error fetching profile:", profileError);
      if (pulseCountDisplay) pulseCountDisplay.innerText = "Error";
      return;
    }

    currentPulseCount = profile.monthly_pulses_remaining;
    updatePulseDisplay(currentPulseCount);
  }

  function updatePulseDisplay(count) {
    if (pulseCountDisplay) {
      pulseCountDisplay.innerText = count === -1 ? "∞" : count.toString();
    }
  }

  // Handle the form submission to generate content
  async function handlePulsarSubmit(e) {
    e.preventDefault();

    if (!submitButton || !outputArea) return;

    submitButton.setAttribute("disabled", "true");
    submitButton.innerHTML = "PULSING...";
    outputArea.innerHTML = `<div class="border border-dashed border-border p-8 text-center"><p class="font-mono text-foreground/70">[PULSING] :: Transmitting signal...</p></div>`;

    try {
      const { data, error } = await supabase.functions.invoke("pulsar-v1", {
        body: {
          url: urlInput.value,
          contentLanguage: contentLanguageInput.value,
          hashtagLanguage: hashtagLanguageInput.value,
        },
      });

      if (error) throw error;

      // Optimistically decrement pulse count for generation and update display
      currentPulseCount--;
      updatePulseDisplay(currentPulseCount);

      const { generatedContent, postId } = data;

      // The `generatedContent` is now an object { linkedIn: "...", twitter: "..." }
      outputArea.innerHTML = `
        <h2 class="text-2xl font-bold uppercase">// Transmission Received</h2>
        <div class="mt-4 space-y-6">
          <!-- LinkedIn Post -->
          <div>
            <h3 class="font-mono text-lg text-foreground/80">// LinkedIn Post</h3>
            <div class="relative mt-2">
              <textarea class="h-48 w-full rounded-none border border-border bg-background p-4 font-mono text-base focus:border-primary focus:outline-none focus:ring-0">${generatedContent.linkedIn}</textarea>
              <div class="mt-2 flex gap-2">
                <button class="publish-btn border border-border px-4 py-2 font-mono text-sm uppercase hover:bg-primary hover:text-background disabled:cursor-not-allowed disabled:bg-gray-500" data-post-id="${postId}" data-network="linkedin">Post to LinkedIn</button>
                <button class="copy-btn border border-border px-4 py-2 font-mono text-sm uppercase hover:bg-primary hover:text-background">Copy Text</button>
              </div>
            </div>
          </div>

          <!-- Twitter/X Post -->
          <div>
            <h3 class="font-mono text-lg text-foreground/80">// X (Twitter) Post</h3>
            <div class="relative mt-2">
              <textarea class="h-32 w-full rounded-none border border-border bg-background p-4 font-mono text-base focus:border-primary focus:outline-none focus:ring-0">${generatedContent.twitter}</textarea>
              <div class="mt-2 flex gap-2">
                <button class="publish-btn border border-border px-4 py-2 font-mono text-sm uppercase hover:bg-primary hover:text-background disabled:cursor-not-allowed disabled:bg-gray-500" data-post-id="${postId}" data-network="twitter">Post to X</button>
                <button class="copy-btn border border-border px-4 py-2 font-mono text-sm uppercase hover:bg-primary hover:text-background">Copy Text</button>
              </div>
            </div>
          </div>
        </div>
      `;
    } catch (error) {
      outputArea.innerHTML = `<div class="border border-red-500/50 p-8 text-center"><p class="font-mono font-bold text-red-400">[ERROR]</p><p class="font-mono text-foreground/70 mt-2">${error.message}</p></div>`;
    } finally {
      submitButton.removeAttribute("disabled");
      submitButton.innerHTML = "Pulsar &gt;&gt;";
    }
  }

  // Handle clicks on dynamically created buttons
  async function handleOutputAreaClick(e) {
    const target = e.target as HTMLElement;

    // Handle Copy Button
    if (target.classList.contains("copy-btn")) {
      const content = target
        .closest(".relative")
        .querySelector("textarea").value;
      navigator.clipboard.writeText(content);
      target.innerText = "Copied!";
      setTimeout(() => {
        target.innerText = "Copy Text";
      }, 2000);
    }

    // Handle Publish Button
    if (target.classList.contains("publish-btn")) {
      const network = target.dataset.network;
      const editedText = target.closest(".relative").querySelector("textarea").value;

      if (!editedText) {
        alert("Cannot publish empty content.");
        return;
      }

      const confirmButtonId = "confirm-publish-btn";

      showModal(
        "// Confirm Publication",
        `<p class="text-foreground/80">Are you sure you want to post this content to ${network}? This will consume 1 Pulse.</p>`,
        `<button id="cancel-publish-btn" type="button" class="border border-border px-4 py-2 font-mono text-sm uppercase hover:bg-gray-800">Cancel</button>
         <button id="${confirmButtonId}" type="button" class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase text-background transition-colors hover:bg-primary/80">Confirm & Post</button>`,
      );

      document.getElementById(confirmButtonId)?.addEventListener("click", async () => {
          hideModal();

          target.setAttribute("disabled", "true");
          target.innerText = "Publishing...";

          try {
            // Pass the edited text directly to the function
            const { error } = await supabase.functions.invoke(
              "publish-to-social",
              {
                body: { network, text: editedText }, // No longer sending original postId
              },
            );

            if (error) throw error;

            // Optimistically decrement pulse count for publishing and update display
            currentPulseCount--;
            updatePulseDisplay(currentPulseCount);

            target.innerText = `Published to ${network}!`;
            // Keep it disabled to prevent re-posting
          } catch (error) {
            target.innerText = `Error!`;
            target.removeAttribute("disabled");
            // Show error in modal instead of alert
            showModal(
              "// Publication Failed",
              `<p class="font-mono text-red-400">${error.message}</p>`,
              `<button id="error-ok-btn" type="button" class="border border-primary bg-primary px-4 py-2 font-mono text-sm font-bold uppercase text-background">OK</button>`,
            );
            document
              .getElementById("error-ok-btn")
              ?.addEventListener("click", hideModal);
          }
        });

      document
        .getElementById("cancel-publish-btn")
        ?.addEventListener("click", hideModal);
    }
  }

  // Initial setup
  if (pulsarForm && outputArea && submitButton) {
    pulsarForm.addEventListener("submit", handlePulsarSubmit);
    outputArea.addEventListener("click", handleOutputAreaClick);
    loadUserData();
  }

  modalCloseBtn?.addEventListener("click", hideModal);
  modalContainer?.addEventListener("click", (e) => {
    if (e.target === modalContainer) {
      hideModal();
    }
  });
</script>