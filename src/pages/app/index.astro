---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Dashboard // PostPulsar">
  <main class="container py-12">
    <div id="welcome-container">
      <h1 id="welcome-message" class="text-3xl font-bold uppercase">
        // Mission Control
      </h1>
      <p class="mt-2 text-foreground/70">
        System ready. Paste the article URL to begin transmission.
      </p>
    </div>

    <div class="mt-8">
      <form id="pulsar-form">
        <div class="flex items-center gap-4">
          <input
            type="url"
            id="post-url"
            name="post-url"
            required
            class="w-full rounded-none border border-border bg-background p-4 font-mono text-lg focus:border-primary focus:outline-none focus:ring-0"
            placeholder="https://your-blog.com/your-awesome-article"
          />
          <button
            type="submit"
            class="h-full border border-primary bg-primary px-8 py-4 font-mono text-lg font-bold uppercase text-background transition-colors hover:bg-primary/80"
            >Pulsar &gt;&gt;</button
          >
        </div>
      </form>
    </div>

    <!-- Future content area -->
    <div id="content-output" class="mt-12"></div>
  </main>
</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  // Check session on page load and personalize message
  async function checkSession() {
    const { data, error } = await supabase.auth.getSession();
    if (error || !data.session) {
      // This is handled by the global auth manager, but as a fallback:
      window.location.href = "/login";
      return;
    }

    const user = data.session.user;
    const welcomeMessage = document.getElementById("welcome-message");
    if (welcomeMessage && user.email) {
      // We can decide if we want to personalize it later.
      // For now, the static message is fine for the aesthetic.
      // welcomeMessage.textContent = `AGENT: ${user.email}`;
    }
  }

  checkSession();

  // Handle form submission (placeholder)
  const pulsarForm = document.getElementById("pulsar-form");
  if (pulsarForm) {
    pulsarForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const urlInput = document.getElementById("post-url") as HTMLInputElement;
      const outputArea = document.getElementById("content-output");

      if (urlInput && outputArea) {
        outputArea.innerHTML = `
          <div class="border border-dashed border-border p-8 text-center">
            <p class="font-mono text-foreground/70">[PULSING] :: Transmitting signal to URL: ${urlInput.value}</p>
            <p class="font-mono text-foreground/70 mt-2">[AWAITING_RESPONSE]...</p>
          </div>
        `;
        // Here we would call the Supabase Edge Function
      }
    });
  }
</script>
