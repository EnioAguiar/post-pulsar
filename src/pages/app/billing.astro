---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="PostPulsar - Billing">
  <main class="grow p-4 md:p-8">
    <div class="container mx-auto max-w-6xl">
      <h1 class="mb-6 text-3xl font-bold uppercase tracking-wider">/Billing</h1>

      <!-- Subscription Plans -->
      <div
        class="mb-8 rounded-lg border border-border bg-background/50 p-6 backdrop-blur-sm"
      >
        <h2 class="mb-4 text-2xl font-semibold text-primary">
          Subscription Plans
        </h2>
        <p class="mb-6 text-foreground/80">
          Upgrade your plan for more pulses and features every month.
        </p>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <!-- Classic Plan -->
          <div
            id="plan_classic_card"
            class="flex flex-col rounded-lg border border-border/50 bg-background/30 p-6 transition-colors"
          >
            <h3 class="text-xl font-bold text-foreground">Classic Plan</h3>
            <p
              data-product-id="plan_classic"
              class="price-display my-4 text-4xl font-bold text-primary"
            >
              $9<span class="text-lg font-normal text-foreground/70">
                /month</span
              >
            </p>
            <p
              id="countdown-plan_classic"
              class="countdown-text mb-4 hidden font-mono text-sm text-yellow-400"
            >
            </p>
            <ul
              class="mb-6 h-full list-inside list-disc space-y-2 text-foreground/70"
            >
              <li>210 Pulses per month</li>
              <li>Unlimited social accounts</li>
              <li>Text and Image Publishing</li>
            </ul>
            <button
              data-product-id="plan_classic"
              class="buy-button mt-4 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80 disabled:cursor-not-allowed disabled:bg-gray-500"
            >
              Subscribe
            </button>
          </div>

          <!-- Pro Plan -->
          <div
            id="plan_pro_card"
            class="flex flex-col rounded-lg border border-border/50 bg-background/30 p-6 transition-colors"
          >
            <h3 class="text-xl font-bold text-foreground">Pro Plan</h3>
            <p
              data-product-id="plan_pro"
              class="price-display my-4 text-4xl font-bold text-primary"
            >
              $29<span class="text-lg font-normal text-foreground/70">
                /month</span
              >
            </p>
            <p
              id="countdown-plan_pro"
              class="countdown-text mb-4 hidden font-mono text-sm text-yellow-400"
            >
            </p>
            <ul
              class="mb-6 h-full list-inside list-disc space-y-2 text-foreground/70"
            >
              <li>500 Pulses per month</li>
              <li>Unlimited social accounts</li>
              <li>Image & Video Publishing</li>
            </ul>
            <button
              data-product-id="plan_pro"
              class="buy-button mt-4 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80 disabled:cursor-not-allowed disabled:bg-gray-500"
            >
              Subscribe
            </button>
          </div>
        </div>
      </div>

      <div
        class="rounded-lg border border-border bg-background/50 p-6 backdrop-blur-sm"
      >
        <h2 class="mb-4 text-2xl font-semibold text-primary">
          Purchase Pulses
        </h2>
        <p class="mb-6 text-foreground/80">
          Pulses do not expire and can be used at any time.
        </p>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          <!-- 100 Pulse Pack -->
          <div
            class="flex flex-col rounded-lg border border-border/50 bg-background/30 p-6"
          >
            <h3 class="text-xl font-bold text-foreground">100 Pulse Pack</h3>
            <p
              data-product-id="pulse_pack_100"
              class="price-display my-4 text-4xl font-bold text-primary"
            >
              $5
            </p>
            <p class="mb-6 h-full text-foreground/70">
              A great boost for your content strategy.
            </p>
            <button
              data-product-id="pulse_pack_100"
              class="buy-button mt-4 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80"
            >
              Buy Now
            </button>
          </div>

          <!-- 250 Pulse Pack -->
          <div
            class="flex flex-col rounded-lg border border-border/50 bg-background/30 p-6"
          >
            <h3 class="text-xl font-bold text-foreground">250 Pulse Pack</h3>
            <p
              data-product-id="pulse_pack_250"
              class="price-display my-4 text-4xl font-bold text-primary"
            >
              $10
            </p>
            <p class="mb-6 h-full text-foreground/70">
              Perfect for regular users who need more creative power.
            </p>
            <button
              data-product-id="pulse_pack_250"
              class="buy-button mt-4 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80"
            >
              Buy Now
            </button>
          </div>

          <!-- 600 Pulse Pack -->
          <div
            class="flex flex-col rounded-lg border border-border/50 bg-background/30 p-6"
          >
            <h3 class="text-xl font-bold text-foreground">600 Pulse Pack</h3>
            <p
              data-product-id="pulse_pack_600"
              class="price-display my-4 text-4xl font-bold text-primary"
            >
              $20
            </p>
            <p class="mb-6 h-full text-foreground/70">
              The best value for power users and content professionals.
            </p>
            <button
              data-product-id="pulse_pack_600"
              class="buy-button mt-4 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80"
            >
              Buy Now
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    import { supabase } from "../../lib/supabase";
    import { showModal } from "../../lib/modal";

    // Helper to format money based on currency
    function formatCurrency(amount, currency) {
      const amountInMajorUnits = amount / 100;
      return new Intl.NumberFormat(undefined, {
        style: "currency",
        currency: currency,
      }).format(amountInMajorUnits);
    }

    async function fetchAndDisplayRegionalPrices() {
      const priceDisplays = document.querySelectorAll(".price-display");
      const buyButtons = document.querySelectorAll(".buy-button");

      // Set initial loading state
      priceDisplays.forEach((el) => {
        const span = el.querySelector("span");
        if (span) {
          el.innerHTML = `... ${span.outerHTML}`;
        } else {
          el.textContent = "...";
        }
      });

      try {
        const { data: prices, error } = await supabase.functions.invoke(
          "get-regional-prices",
        );

        if (error) throw error;
        if (!prices) return;

        // Update prices and buttons
        for (const productId in prices) {
          const priceData = prices[productId];
          if (!priceData) continue;

          const { priceId, amount, currency } = priceData;

          // Update price display
          const priceElement = document.querySelector(
            `.price-display[data-product-id='${productId}']`,
          );
          if (priceElement) {
            const formattedPrice = formatCurrency(amount, currency);
            const span = priceElement.querySelector("span");
            if (span) {
              priceElement.innerHTML = `${formattedPrice}${span.outerHTML}`;
            } else {
              priceElement.textContent = formattedPrice;
            }
          }

          // Update buy button with priceId
          const buttonElement = document.querySelector(
            `.buy-button[data-product-id='${productId}']`,
          ) as HTMLButtonElement;
          if (buttonElement) {
            buttonElement.dataset.priceId = priceId;
          }
        }
      } catch (e) {
        console.error(
          "Could not fetch regional prices. Displaying default prices.",
          e.message,
        );
        // In case of error, the page will just show the default hardcoded prices.
      }
    }

    function displayCountdown(expiresAt, planId) {
      const countdownElement = document.getElementById(
        `countdown-plan_${planId}`,
      );
      if (!countdownElement) return;

      const now = new Date().getTime();
      const expirationTime = new Date(expiresAt * 1000).getTime();
      const distance = expirationTime - now;

      if (distance < 0) {
        countdownElement.textContent = "Your plan has expired.";
        countdownElement.classList.remove("hidden");
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor(
        (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
      );

      countdownElement.textContent = `Your plan expires in ${days} days and ${hours} hours.`;
      countdownElement.classList.remove("hidden");
    }

    async function updateSubscriptionUI() {
      console.log("[Billing Page] Fetching subscription status...");
      try {
        const { data, error } = await supabase.functions.invoke(
          "get-subscription-details",
        );
        console.log("[Billing Page] Received data from function:", data);

        if (error) throw error;

        if (data && data.active) {
          console.log("[Billing Page] Active subscription found:", data.planId);
          const { planId, expiresAt } = data;
          const planCard = document.getElementById(`plan_${planId}_card`);
          const planButton = planCard?.querySelector(
            ".buy-button",
          ) as HTMLButtonElement | null;

          if (planCard && planButton) {
            console.log("[Billing Page] Updating UI for active plan.");
            planCard.classList.remove("border-border/50", "bg-background/30");
            planCard.classList.add("border-green-500/50", "bg-green-500/10");

            displayCountdown(expiresAt, planId);

            planButton.disabled = true;
            planButton.textContent = "Current Plan";

            const now = new Date().getTime();
            const expirationTime = new Date(expiresAt * 1000).getTime();
            const fiveDaysInMillis = 5 * 24 * 60 * 60 * 1000;

            if (expirationTime - now <= fiveDaysInMillis && expirationTime > now) {
                console.log("[Billing Page] Plan is expiring soon. Enabling renew button.");
                planButton.disabled = false;
                planButton.textContent = "Buy Again";
            }
          }
          return true; 
        } else {
          console.log("[Billing Page] No active subscription found.");
        }
        return false; 
      } catch (e) {
        console.error("Error fetching subscription status:", e.message);
        return false;
      }
    }

    document.querySelectorAll(".buy-button").forEach((button) => {
      button.addEventListener("click", async () => {
        const btn = button as HTMLButtonElement;
        const priceId = btn.dataset.priceId;

        if (!priceId) {
            showModal("Error", "<p>Could not find price information. Please refresh the page and try again.</p>", "");
            return;
        }

        // Disable all buttons to prevent multiple clicks
        document.querySelectorAll(".buy-button").forEach((b) => ((b as HTMLButtonElement).disabled = true));
        btn.textContent = "Processing...";

        try {
          // Check for referral ID and include it in the body
          const referralId = (window as any).promotekit_referral;
          const body: { priceId: string; referral?: string } = { priceId };
          if (referralId) {
            body.referral = referralId;
          }

          const { data, error } = await supabase.functions.invoke(
            "create-payment-intent",
            {
              body: body,
            },
          );

          if (error) {
            throw new Error(error.message);
          }

          if (data.checkoutUrl) {
            window.location.href = data.checkoutUrl;
          } else {
            throw new Error("Could not retrieve checkout URL.");
          }
        } catch (e) {
          console.error("Purchase initiation failed:", e);
          showModal(
            "Error",
            `<p>Could not initiate purchase. Please try again.</p>`,
            "",
          );
          // Re-enable buttons on failure
          document.querySelectorAll(".buy-button").forEach((b) => {
            (b as HTMLButtonElement).disabled = false;
            const originalText = b.dataset.productId?.startsWith("plan_")
              ? "Subscribe"
              : "Buy Now";
            b.textContent = originalText;
          });
        }
      });
    });

    // --- Main Logic on Page Load ---
    document.addEventListener("DOMContentLoaded", async () => {
      await fetchAndDisplayRegionalPrices();

      const urlParams = new URLSearchParams(window.location.search);
      const isSuccessRedirect =
        urlParams.get("purchase_success") === "true";

      if (isSuccessRedirect) {
        const successTitle = "Payment Successful";
        const successBody = `<p class="text-lg font-semibold text-green-400 mb-2">Your purchase has been successfully processed!</p><p class="text-foreground/70">The new pulses or your plan benefits have been added to your account.</p>`;
        const successFooter = `<button data-modal-close class="border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80">Continue</button>`;
        showModal(successTitle, successBody, successFooter);
        window.history.replaceState(
          {},
          document.title,
          window.location.pathname,
        );

        // Simplified UI update after success
        // A full refresh or more targeted update could also work
        setTimeout(() => window.location.reload(), 4000);

      } else {
        // This is a normal page load, just check the status once.
        updateSubscriptionUI();
      }
    });
  </script>
</Layout>
