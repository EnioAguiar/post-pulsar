---
import Layout from "../../layouts/Layout.astro";
import Modal from "../../components/Modal.astro";
---

<Layout title="PostPulsar - Billing">
  <main class="grow p-4 md:p-8">
    <div class="container mx-auto max-w-6xl">
      <h1 class="mb-6 text-3xl font-bold uppercase tracking-wider">/Billing</h1>

      <!-- Subscription Plans -->
      <div
        class="mb-8 rounded-lg border border-border bg-background/50 p-6 backdrop-blur-sm"
      >
        <h2 class="mb-4 text-2xl font-semibold text-primary">
          Subscription Plans
        </h2>
        <p class="mb-6 text-foreground/80">
          Upgrade your plan for more pulses and features every month.
        </p>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <!-- Classic Plan -->
          <div
            class="flex flex-col rounded-lg border border-border/50 bg-background/30 p-6"
          >
            <h3 class="text-xl font-bold text-foreground">Classic Plan</h3>
            <p class="my-4 text-4xl font-bold text-primary">$9<span class="text-lg font-normal text-foreground/70">/month</span></p>
            <ul class="mb-6 h-full list-inside list-disc space-y-2 text-foreground/70">
              <li>210 Pulses per month</li>
              <li>Unlimited social accounts</li>
              <li>Text and Image Publishing</li>
            </ul>
            <button
              data-product-id="plan_classic"
              class="buy-button mt-4 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80"
            >
              Subscribe
            </button>
          </div>

          <!-- Pro Plan -->
          <div
            class="flex flex-col rounded-lg border border-border/50 bg-background/30 p-6"
          >
            <h3 class="text-xl font-bold text-foreground">Pro Plan</h3>
            <p class="my-4 text-4xl font-bold text-primary">$29<span class="text-lg font-normal text-foreground/70">/month</span></p>
            <ul class="mb-6 h-full list-inside list-disc space-y-2 text-foreground/70">
              <li>500 Pulses per month</li>
              <li>Unlimited social accounts</li>
              <li>Image & Video Publishing</li>
            </ul>
            <button
              data-product-id="plan_pro"
              class="buy-button mt-4 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80"
            >
              Subscribe
            </button>
          </div>
        </div>
      </div>

      <div
        class="rounded-lg border border-border bg-background/50 p-6 backdrop-blur-sm"
      >
        <h2 class="mb-4 text-2xl font-semibold text-primary">
          Purchase Pulses
        </h2>
        <p class="mb-6 text-foreground/80">
          Pulses do not expire and can be used at any time.
        </p>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          <!-- 100 Pulse Pack -->
          <div
            class="flex flex-col rounded-lg border border-border/50 bg-background/30 p-6"
          >
            <h3 class="text-xl font-bold text-foreground">100 Pulse Pack</h3>
            <p class="my-4 text-4xl font-bold text-primary">$5</p>
            <p class="mb-6 h-full text-foreground/70">
              A great boost for your content strategy.
            </p>
            <button
              data-product-id="pulse_pack_100"
              class="buy-button mt-4 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80"
            >
              Buy Now
            </button>
          </div>

          <!-- 250 Pulse Pack -->
          <div
            class="flex flex-col rounded-lg border border-border/50 bg-background/30 p-6"
          >
            <h3 class="text-xl font-bold text-foreground">250 Pulse Pack</h3>
            <p class="my-4 text-4xl font-bold text-primary">$10</p>
            <p class="mb-6 h-full text-foreground/70">
              Perfect for regular users who need more creative power.
            </p>
            <button
              data-product-id="pulse_pack_250"
              class="buy-button mt-4 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80"
            >
              Buy Now
            </button>
          </div>

          <!-- 600 Pulse Pack -->
          <div
            class="flex flex-col rounded-lg border border-border/50 bg-background/30 p-6"
          >
            <h3 class="text-xl font-bold text-foreground">600 Pulse Pack</h3>
            <p class="my-4 text-4xl font-bold text-primary">$20</p>
            <p class="mb-6 h-full text-foreground/70">
              The best value for power users and content professionals.
            </p>
            <button
              data-product-id="pulse_pack_600"
              class="buy-button mt-4 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80"
            >
              Buy Now
            </button>
          </div>
        </div>

        <!-- Stripe Payment Element will be mounted here -->
        <div id="payment-container" class="mx-auto mt-8 hidden max-w-md">
          <h3
            id="payment-header"
            class="mb-4 text-center text-lg font-semibold"
          >
          </h3>
          <div id="payment-element"></div>
          <button
            id="pay-button"
            class="mt-6 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80"
          >
            Pay Now
          </button>
          <div
            id="payment-message"
            class="mt-2 hidden text-center text-sm text-red-500"
          >
          </div>
        </div>
      </div>
    </div>
  </main>

  <Modal modalId="success-modal" title="Payment Successful">
    <p class="text-foreground/80">
      Your pulses have been successfully added to your account.
    </p>
    <div class="mt-6 flex justify-end">
      <button
        data-modal-close="success-modal"
        class="border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80"
      >
        Continue
      </button>
    </div>
  </Modal>

  <script>
    import { type Stripe, loadStripe } from "@stripe/stripe-js";
    import { supabase } from "../../lib/supabase";
    import { showModal } from "../../lib/modal";

    const buyButtons = document.querySelectorAll(".buy-button");
    const paymentContainer = document.getElementById("payment-container");
    const paymentMessage = document.getElementById("payment-message");
    const payButton = document.getElementById(
      "pay-button",
    ) as HTMLButtonElement;
    const paymentHeader = document.getElementById("payment-header");

    let stripe: Stripe | null = null;
    let elements: StripeElements | null = null;

    const stripePublicKey = import.meta.env.PUBLIC_STRIPE_KEY;

    if (!stripePublicKey) {
      console.error("Stripe public key not configured.");
      buyButtons.forEach((btn) => {
        (btn as HTMLButtonElement).disabled = true;
        btn.textContent = "Payment configuration invalid";
      });
    }

    const appearance = {
      variables: {
        fontFamily: '"IBM Plex Mono", monospace',
        borderRadius: "0.25rem",
        colorPrimary: "#FF4500",
        colorBackground: "#0A0A0A",
        colorText: "#E0E0E0",
        colorDanger: "#ef4444",
        colorTextSecondary: "#E0E0E0",
        colorTextPlaceholder: "#6b7280",
        borderColor: "#272727",
        spacingUnit: "0.25rem",
      },
      rules: {
        ".Input": {
          border: "1px solid #272727",
        },
        ".Input:focus": {
          boxShadow: "0 0 0 1px #FF4500",
          borderColor: "#FF4500",
        },
        ".Input--invalid": {
          boxShadow: "0 0 0 1px #ef4444",
          borderColor: "#ef4444",
        },
      },
    };

    buyButtons.forEach((button) => {
      button.addEventListener("click", async () => {
        const btn = button as HTMLButtonElement;
        const productId = btn.dataset.productId;
        const productName =
          btn.parentElement?.querySelector("h3")?.textContent || "";

        buyButtons.forEach((b) => ((b as HTMLButtonElement).disabled = true));
        btn.textContent = "Processing...";

        const idempotencyKey = crypto.randomUUID();
        localStorage.setItem("idempotency_key", idempotencyKey);

        const { data, error } = await supabase.functions.invoke(
          "create-payment-intent",
          {
            body: { productId, idempotencyKey },
          },
        );

        if (error) {
          showMessage(`Error: ${error.message}`);
          buyButtons.forEach(
            (b) => ((b as HTMLButtonElement).disabled = false),
          );
          btn.textContent = "Buy Now"; // Or "Subscribe"
          return;
        }

        // Handle the two possible flows: Stripe Checkout or Stripe Elements
        if (data.checkoutUrl) {
          // --- Checkout Flow (Subscriptions) ---
          window.location.href = data.checkoutUrl;
          // No need to re-enable buttons as the page will redirect
        } else if (data.clientSecret) {
          // --- Embedded Elements Flow (One-time purchases) ---
          const { clientSecret } = data;

          if (!stripe) {
            stripe = await loadStripe(stripePublicKey, { locale: "en" });
          }
          if (!stripe) return console.error("Failed to load Stripe.js");

          elements = stripe.elements({ clientSecret, appearance });
          const paymentElement = elements.create("payment");
          paymentElement.mount("#payment-element");

          paymentHeader!.textContent = `Complete your purchase for: ${productName}`;
          paymentContainer!.classList.remove("hidden");
          payButton.disabled = false;
          payButton.textContent = "Pay Now";
        } else {
          showMessage("Invalid response from server.");
          buyButtons.forEach(
            (b) => ((b as HTMLButtonElement).disabled = false),
          );
          btn.textContent = "Buy Now"; // Or "Subscribe"
        }
      });
    });

    payButton.addEventListener("click", async (e) => {
      e.preventDefault();
      if (!stripe || !elements) return;
      await handleSubmit(stripe, elements);
    });

    async function handleSubmit(stripe: Stripe, elements: any) {
      payButton.disabled = true;
      payButton.textContent = "Confirming...";

      const { error } = await stripe.confirmPayment({
        elements,
        confirmParams: {
          return_url:
            window.location.href.split("?")[0] + "?payment_success=true",
        },
      });

      if (error.type === "card_error" || error.type === "validation_error") {
        showMessage(error.message);
      } else {
        showMessage("An unexpected error occurred.");
      }

      payButton.disabled = false;
      payButton.textContent = "Pay Now";
    }

    function showMessage(messageText: string | undefined) {
      if (!messageText) return;
      paymentMessage!.classList.remove("hidden");
      paymentMessage!.textContent = messageText;

      setTimeout(() => {
        paymentMessage!.classList.add("hidden");
        paymentMessage!.textContent = "";
      }, 5000);
    }

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get("payment_success") === "true") {
      localStorage.removeItem("idempotency_key");
      showModal("success-modal");
      window.history.replaceState({}, document.title, window.location.pathname);
    }
  </script>
</Layout>
