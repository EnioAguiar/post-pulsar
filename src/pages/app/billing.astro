---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="PostPulsar - Billing">
  <main class="grow p-4 md:p-8">
    <div class="container mx-auto max-w-6xl">
      <h1 class="mb-6 text-3xl font-bold uppercase tracking-wider">/Billing</h1>

      <!-- Subscription Plans -->
      <div
        class="mb-8 rounded-lg border border-border bg-background/50 p-6 backdrop-blur-sm"
      >
        <h2 class="mb-4 text-2xl font-semibold text-primary">
          Subscription Plans
        </h2>
        <p class="mb-6 text-foreground/80">
          Upgrade your plan for more pulses and features every month.
        </p>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <!-- Classic Plan -->
          <div
            id="plan_classic_card"
            class="flex flex-col rounded-lg border border-border/50 bg-background/30 p-6 transition-colors"
          >
            <h3 class="text-xl font-bold text-foreground">Classic Plan</h3>
            <p class="my-4 text-4xl font-bold text-primary">$9<span class="text-lg font-normal text-foreground/70">/month</span></p>
            <ul class="mb-6 h-full list-inside list-disc space-y-2 text-foreground/70">
              <li>210 Pulses per month</li>
              <li>Unlimited social accounts</li>
              <li>Text and Image Publishing</li>
            </ul>
            <button
              data-product-id="plan_classic"
              class="buy-button mt-4 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80 disabled:cursor-not-allowed disabled:bg-gray-500"
            >
              Subscribe
            </button>
          </div>

          <!-- Pro Plan -->
          <div
            id="plan_pro_card"
            class="flex flex-col rounded-lg border border-border/50 bg-background/30 p-6 transition-colors"
          >
            <h3 class="text-xl font-bold text-foreground">Pro Plan</h3>
            <p class="my-4 text-4xl font-bold text-primary">$29<span class="text-lg font-normal text-foreground/70">/month</span></p>
            <ul class="mb-6 h-full list-inside list-disc space-y-2 text-foreground/70">
              <li>500 Pulses per month</li>
              <li>Unlimited social accounts</li>
              <li>Image & Video Publishing</li>
            </ul>
            <button
              data-product-id="plan_pro"
              class="buy-button mt-4 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80 disabled:cursor-not-allowed disabled:bg-gray-500"
            >
              Subscribe
            </button>
          </div>
        </div>
      </div>

      <div
        class="rounded-lg border border-border bg-background/50 p-6 backdrop-blur-sm"
      >
        <h2 class="mb-4 text-2xl font-semibold text-primary">
          Purchase Pulses
        </h2>
        <p class="mb-6 text-foreground/80">
          Pulses do not expire and can be used at any time.
        </p>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          <!-- 100 Pulse Pack -->
          <div
            class="flex flex-col rounded-lg border border-border/50 bg-background/30 p-6"
          >
            <h3 class="text-xl font-bold text-foreground">100 Pulse Pack</h3>
            <p class="my-4 text-4xl font-bold text-primary">$5</p>
            <p class="mb-6 h-full text-foreground/70">
              A great boost for your content strategy.
            </p>
            <button
              data-product-id="pulse_pack_100"
              class="buy-button mt-4 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80"
            >
              Buy Now
            </button>
          </div>

          <!-- 250 Pulse Pack -->
          <div
            class="flex flex-col rounded-lg border border-border/50 bg-background/30 p-6"
          >
            <h3 class="text-xl font-bold text-foreground">250 Pulse Pack</h3>
            <p class="my-4 text-4xl font-bold text-primary">$10</p>
            <p class="mb-6 h-full text-foreground/70">
              Perfect for regular users who need more creative power.
            </p>
            <button
              data-product-id="pulse_pack_250"
              class="buy-button mt-4 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80"
            >
              Buy Now
            </button>
          </div>

          <!-- 600 Pulse Pack -->
          <div
            class="flex flex-col rounded-lg border border-border/50 bg-background/30 p-6"
          >
            <h3 class="text-xl font-bold text-foreground">600 Pulse Pack</h3>
            <p class="my-4 text-4xl font-bold text-primary">$20</p>
            <p class="mb-6 h-full text-foreground/70">
              The best value for power users and content professionals.
            </p>
            <button
              data-product-id="pulse_pack_600"
              class="buy-button mt-4 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80"
            >
              Buy Now
            </button>
          </div>
        </div>

        <!-- Stripe Payment Element will be mounted here -->
        <div id="payment-container" class="mx-auto mt-8 hidden max-w-md">
          <h3
            id="payment-header"
            class="mb-4 text-center text-lg font-semibold"
          >
          </h3>
          <div id="payment-element"></div>
          <button
            id="pay-button"
            class="mt-6 w-full border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80"
          >
            Pay Now
          </button>
          <div
            id="payment-message"
            class="mt-2 hidden text-center text-sm text-red-500"
          >
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    import { supabase } from "../../lib/supabase";
    import { showModal } from "../../lib/modal";

    async function updateSubscriptionUI() {
      console.log("[Billing Page] Fetching subscription status...");
      try {
        const { data, error } = await supabase.functions.invoke(
          "get-subscription-details",
        );
        console.log("[Billing Page] Received data from function:", data);

        if (error) throw error;

        if (data && data.active) {
          console.log("[Billing Page] Active subscription found:", data.planId);
          const { planId, expiresAt } = data;
          const planCard = document.getElementById(`plan_${planId}_card`);
          const planButton = planCard?.querySelector(".buy-button") as HTMLButtonElement | null;

          if (planCard && planButton) {
            console.log("[Billing Page] Updating UI for active plan.");
            // Style the active plan card
            planCard.classList.remove("border-border/50", "bg-background/30");
            planCard.classList.add("border-green-500/50", "bg-green-500/10");

            // Disable the button
            planButton.disabled = true;
            planButton.textContent = "Current Plan";

            // Check if the subscription is expiring soon
            const now = new Date();
            const expiresDate = new Date(expiresAt * 1000);
            const fiveDays = 5 * 24 * 60 * 60 * 1000;
            const isExpiringSoon = expiresDate.getTime() - now.getTime() <= fiveDays;
            console.log(`[Billing Page] Checking expiration. Is expiring soon: ${isExpiringSoon}`);

            if (isExpiringSoon) {
              planButton.disabled = false;
              planButton.textContent = "Renew";
            }
          }
          return true; // Indicate that the UI has been updated
        } else {
          console.log("[Billing Page] No active subscription found.");
        }
        return false; // Indicate no active plan was found
      } catch (e) {
        console.error("Error fetching subscription status:", e.message);
        return false;
      }
    }

    const buyButtons = document.querySelectorAll(".buy-button");

    buyButtons.forEach((button) => {
      button.addEventListener("click", async () => {
        const btn = button as HTMLButtonElement;
        const productId = btn.dataset.productId;

        // Disable all buttons to prevent multiple clicks
        buyButtons.forEach((b) => ((b as HTMLButtonElement).disabled = true));
        btn.textContent = "Processing...";

        try {
          const { data, error } = await supabase.functions.invoke(
            "create-payment-intent",
            {
              body: { productId },
            },
          );

          if (error) {
            throw new Error(error.message);
          }

          if (data.checkoutUrl) {
            window.location.href = data.checkoutUrl;
          } else {
            throw new Error("Could not retrieve checkout URL.");
          }
        } catch (e) {
          console.error("Purchase initiation failed:", e);
          showModal("Error", `<p>Could not initiate purchase. Please try again.</p>`, "");
          // Re-enable buttons on failure
          buyButtons.forEach((b) => {
            (b as HTMLButtonElement).disabled = false;
            const originalText = b.dataset.productId?.startsWith("plan_")
              ? "Subscribe"
              : "Buy Now";
            b.textContent = originalText;
          });
        }
      });
    });

    // --- Main Logic on Page Load ---
    document.addEventListener("DOMContentLoaded", () => {
      const urlParams = new URLSearchParams(window.location.search);
      const isSuccessRedirect = urlParams.get("payment_success") === "true" || urlParams.get("subscription_success") === "true";

      if (isSuccessRedirect) {
        // This is a redirect from a successful payment. Poll for the update.
        const successTitle = "Payment Successful";
        const successBody = `<p class="text-lg font-semibold text-green-400 mb-2">Your purchase has been successfully processed!</p><p class="text-foreground/70">The new pulses or your plan benefits have been added to your account.</p>`;
        const successFooter = `<button data-modal-close class="border border-primary bg-primary px-4 py-2 font-bold uppercase text-background transition-colors hover:bg-primary/80">Continue</button>`;
        showModal(successTitle, successBody, successFooter);
        window.history.replaceState({}, document.title, window.location.pathname);

        let attempts = 0;
        const maxAttempts = 5; // Poll for 10 seconds (5 attempts * 2s interval)
        const interval = setInterval(async () => {
          console.log(`Polling for subscription status... Attempt ${attempts + 1}`);
          const updated = await updateSubscriptionUI();
          attempts++;
          if (updated || attempts >= maxAttempts) {
            clearInterval(interval);
            if (!updated) {
              console.error("Could not confirm subscription update after polling.");
            }
          }
        }, 2000);

      } else {
        // This is a normal page load, just check the status once.
        updateSubscriptionUI();
      }
    });

  </script>
</Layout>
