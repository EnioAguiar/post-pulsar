---

import Layout from "../../layouts/Layout.astro";
---

<Layout title="Account Settings | PostPulsar">
  <main class="bg-gray-50 min-h-screen">
    <div class="container mx-auto max-w-3xl px-6 py-12">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Account Settings</h1>
        <p class="mt-1 text-gray-600">
          Manage your account details and security settings.
        </p>
      </div>

      <!-- Email Management -->
      <div class="bg-white p-6 rounded-lg shadow-md mb-6">
        <h2 class="text-xl font-semibold text-gray-800 border-b pb-3">
          Email Address
        </h2>
        <div class="mt-4 flex justify-between items-center">
          <div>
            <p class="text-gray-600">Your current email address is:</p>
            <p id="user-email" class="font-medium text-gray-800">Loading...</p>
          </div>
          <button
            id="change-email-btn"
            class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded-lg text-sm"
          >
            Change Email
          </button>
        </div>
        <div id="email-message" class="mt-4 text-sm"></div>
      </div>

      <!-- Password Management -->
      <div class="bg-white p-6 rounded-lg shadow-md mb-6">
        <h2 class="text-xl font-semibold text-gray-800 border-b pb-3">
          Change Password
        </h2>
        <form id="password-form" class="mt-4 space-y-4">
          <div>
            <label
              for="new-password"
              class="block text-sm font-medium text-gray-700"
              >New Password</label
            >
            <input
              type="password"
              id="new-password"
              name="new-password"
              class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
              required
            />
          </div>
          <div>
            <label
              for="confirm-password"
              class="block text-sm font-medium text-gray-700"
              >Confirm New Password</label
            >
            <input
              type="password"
              id="confirm-password"
              name="confirm-password"
              class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
              required
            />
          </div>
          <button
            type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg"
          >
            Update Password
          </button>
        </form>
        <div id="password-message" class="mt-4 text-sm"></div>
      </div>

      <!-- Social Connections -->
      <div class="bg-white p-6 rounded-lg shadow-md mb-6">
        <h2 class="text-xl font-semibold text-gray-800 border-b pb-3">
          Social Connections
        </h2>
        <div class="mt-4">
          <button
            id="link-google-btn"
            class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg flex items-center justify-center transition-colors duration-200"
          >
            <svg
              class="w-5 h-5 mr-2"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              ></path><path
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              ></path><path
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"
              ></path><path
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
              ></path><path fill="none" d="M1 1h22v22H1z"></path>
            </svg>
            <span id="link-google-btn-text">Link Google Account</span>
          </button>
        </div>
      </div>

      <!-- Danger Zone -->
      <div class="bg-white p-6 rounded-lg shadow-md border-2 border-red-500">
        <h2 class="text-xl font-semibold text-red-600 border-b border-red-300 pb-3">
          Danger Zone
        </h2>
        <div class="mt-4">
          <p class="text-gray-600 mb-4">
            Deleting your account is a permanent action and cannot be undone.
          </p>
          <button
            id="delete-account-btn"
            class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg"
          >
            Delete My Account
          </button>
        </div>
      </div>
    </div>
  </main>

  <!-- Email Change Modal -->
  <div id="email-modal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
      <div class="mt-3 text-center">
        <h3 class="text-lg leading-6 font-medium text-gray-900">Change Email Address</h3>
        <div class="mt-2 px-7 py-3">
          <input type="email" id="new-email-input" placeholder="Enter your new email" class="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" />
        </div>
        <div class="items-center px-4 py-3">
          <button id="confirm-email-change-btn" class="px-4 py-2 bg-blue-600 text-white text-base font-medium rounded-md w-full shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
            Confirm Change
          </button>
          <button id="cancel-email-change-btn" class="mt-3 px-4 py-2 bg-gray-200 text-gray-800 text-base font-medium rounded-md w-full shadow-sm hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-500">
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>

</Layout>

<script>
  import { supabase } from "../../lib/supabase";

  async function setupAccountPage() {
    const { data, error } = await supabase.auth.getSession();
    if (error || !data.session) {
      window.location.href = "/login"; // Redirect if not logged in
      return;
    }

    const user = data.session.user;
    const userEmailEl = document.getElementById("user-email");
    if (userEmailEl && user.email) {
      userEmailEl.textContent = user.email;
    }

    // --- Password Management ---
    const passwordForm = document.getElementById("password-form");
    const passwordMessageEl = document.getElementById("password-message");

    passwordForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      passwordMessageEl.textContent = "";
      const newPassword = e.target["new-password"].value;
      const confirmPassword = e.target["confirm-password"].value;

      if (newPassword.length < 6) {
        passwordMessageEl.textContent = "Password must be at least 6 characters long.";
        passwordMessageEl.className = "text-red-500";
        return;
      }
      if (newPassword !== confirmPassword) {
        passwordMessageEl.textContent = "Passwords do not match.";
        passwordMessageEl.className = "text-red-500";
        return;
      }

      const { error: updateError } = await supabase.auth.updateUser({ password: newPassword });
      if (updateError) {
        passwordMessageEl.textContent = `Error: ${updateError.message}`;
        passwordMessageEl.className = "text-red-500";
      } else {
        passwordMessageEl.textContent = "Password updated successfully!";
        passwordMessageEl.className = "text-green-500";
        e.target.reset();
      }
    });

    // --- Email Management ---
    const emailModal = document.getElementById("email-modal");
    const changeEmailBtn = document.getElementById("change-email-btn");
    const confirmEmailChangeBtn = document.getElementById("confirm-email-change-btn");
    const cancelEmailChangeBtn = document.getElementById("cancel-email-change-btn");
    const newEmailInput = document.getElementById("new-email-input");
    const emailMessageEl = document.getElementById("email-message");

    changeEmailBtn.addEventListener("click", () => {
      emailMessageEl.textContent = "";
      newEmailInput.value = "";
      emailModal.classList.remove("hidden");
    });

    cancelEmailChangeBtn.addEventListener("click", () => {
      emailModal.classList.add("hidden");
    });

    confirmEmailChangeBtn.addEventListener("click", async () => {
      const newEmail = newEmailInput.value;
      if (newEmail && newEmail !== user.email) {
        const { error: updateError } = await supabase.auth.updateUser({ email: newEmail });
        if (updateError) {
          console.error("Supabase error details:", JSON.stringify(updateError, null, 2));
          emailMessageEl.textContent = `Error: ${updateError.message}`;
          emailMessageEl.className = "text-red-500";
        } else {
          emailMessageEl.innerHTML = `
            <div class="p-3 bg-yellow-100 border border-yellow-300 text-yellow-800 rounded-md">
              <h4 class="font-bold">IMPORTANT: Action Required</h4>
              <p>To complete the change, you must click the confirmation link sent to BOTH your <strong>OLD and NEW</strong> email addresses. Please check both inboxes.</p>
            </div>
          `;
        }
        emailModal.classList.add("hidden");
      } else if (newEmail) {
        emailMessageEl.textContent = "Please enter a different email address.";
        emailMessageEl.className = "text-yellow-500";
      } else {
        emailMessageEl.textContent = "Email cannot be empty.";
        emailMessageEl.className = "text-red-500";
      }
    });

    // --- Google Account Linking ---
    const linkGoogleBtn = document.getElementById("link-google-btn");
    const linkGoogleBtnText = document.getElementById("link-google-btn-text");

    const isGoogleLinked = user.app_metadata.providers.includes("google");

    if (isGoogleLinked) {
      linkGoogleBtnText.textContent = "Google Account Linked";
      linkGoogleBtn.disabled = true;
      linkGoogleBtn.classList.remove("bg-red-600", "hover:bg-red-700");
      linkGoogleBtn.classList.add("bg-green-600", "cursor-not-allowed");
    } else {
      linkGoogleBtn.addEventListener("click", async () => {
        const { error } = await supabase.auth.signInWithOAuth({
          provider: "google",
          options: {
            redirectTo: window.location.href, // Redirect back to settings page
          },
        });
        if (error) {
          alert(`Error linking Google account: ${error.message}`);
        }
      });
    }

    // --- Delete Account ---
    const deleteAccountBtn = document.getElementById("delete-account-btn");
    deleteAccountBtn.addEventListener("click", async () => {
        const confirmation = confirm("Are you sure you want to delete your account? This action is irreversible and will permanently delete all your data.");
        if (confirmation) {
            const { error } = await supabase.functions.invoke('delete-user', {
                method: 'POST',
            });

            if (error) {
                alert(`Error deleting account: ${error.message}`);
            } else {
                alert("Your account has been successfully deleted.");
                await supabase.auth.signOut();
                window.location.href = "/";
            }
        }
    });

  }

  setupAccountPage();
</script>