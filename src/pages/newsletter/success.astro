---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Subscription Confirmed!">
  <main
    class="flex flex-col items-center justify-center min-h-screen p-4 text-center"
  >
    <h1 class="text-4xl font-bold text-green-500 mb-4">Success!</h1>
    <p class="text-lg text-gray-300 mb-8">
      Your subscription to the PostPulsar newsletter has been successfully
      confirmed.
    </p>
    <p class="text-md text-gray-400">
      Thank you for joining our community! Keep an eye on your inbox for news
      and tips.
    </p>
    <a
      href="/"
      class="mt-8 px-6 py-3 border border-primary bg-background text-primary text-lg transition duration-300"
      >Back to Home</a
    >
  </main>
</Layout>
