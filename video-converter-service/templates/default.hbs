<html>
  <head>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap");
      body {
        font-family: "Poppins", sans-serif;
        background-color: #1a1a1a;
        color: #ffffff;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 1080px;
        height: 1080px;
        margin: 0;
        padding: 60px;
        box-sizing: border-box;
      }
      .container {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center; /* Alinha o texto e o logo */
        align-items: center;
        text-align: center;
        border: 10px solid {{color}};
        border-radius: 30px;
        padding: 40px;
        box-sizing: border-box;
        position: relative; /* Necessário para o posicionamento absoluto do logo */
      }
      .text {
        font-size: 52px;
        font-weight: 600;
        line-height: 1.3;
        margin: 0;
        /* padding-bottom removido para evitar empurrar o conteúdo */
      }
      .logo {
        position: absolute;
        bottom: 40px; /* Posiciona no rodapé do container */
        left: 0;
        right: 0;
        margin: 0 auto;
        font-size: 32px;
        font-weight: 600;
        color: {{color}};
      }
    </style>
  </head>
  <body>
    <div class="container">
      <p class="text">{{text}}</p>
      <div class="logo">
        PostPulsar
      </div>
    </div>
  </body>
</html>
