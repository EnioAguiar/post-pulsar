<html>
  <head>
    <style
    >
      @import url("https://fonts.googleapis.com/css2?family=Anton&family=IBM+Plex+Mono&family=Inconsolata&family=Inter&family=Lato&family=Montserrat&family=Oswald&family=Playfair+Display&family=Poppins&family=Roboto&family=Share+Tech+Mono&display=swap");
      body {
        font-family: {{fontFamily}};
        background-color: #ffffff;
        color: #000000;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 1080px;
        height: 1080px;
        margin: 0;
        padding: 80px;
        box-sizing: border-box;
      }
      .container {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between; /* Pushes text to top and logo to bottom */
        align-items: flex-start; /* Aligns items to the left */
        text-align: left;
        padding: 20px;
        box-sizing: border-box;
      }
      .text {
        font-size: 60px;
        font-weight: 600;
        line-height: 1.2;
        margin: 0;
        color: {{color}}; /* Main text uses the selected color */
      }
      .logo {
        font-size: 24px;
        font-weight: 400;
        color: #888888; /* A subtle grey for the logo */
        align-self: flex-start; /* Ensures logo is also left-aligned */
      }
    </style>
  </head>
  <body>
    <div class="container">
      <p class="text">“{{text}}”</p>
      <div class="logo">
        Generated by PostPulsar
      </div>
    </div>
  </body>
</html>