<html>
  <head>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700&display=swap");
      body {
        font-family: "Montserrat", sans-serif;
        background-color: #F0F2F5;
        color: #1c1e21;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 1080px;
        height: 1080px;
        margin: 0;
        padding: 60px;
        box-sizing: border-box;
      }
      .container {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        border: 12px solid {{color}};
        border-radius: 20px;
        padding: 45px;
        box-sizing: border-box;
        position: relative;
        background-color: #FFFFFF;
      }
      .text {
        font-size: 48px;
        font-weight: 500;
        line-height: 1.4;
        margin: 0;
        padding-bottom: 60px;
      }
      .logo {
        position: absolute;
        bottom: 45px;
        left: 0;
        right: 0;
        margin: 0 auto;
        font-size: 28px;
        font-weight: 700;
        color: {{color}};
        letter-spacing: 1px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <p class="text">{{text}}</p>
      <div class="logo">
        POSTPULSAR
      </div>
    </div>
  </body>
</html>
