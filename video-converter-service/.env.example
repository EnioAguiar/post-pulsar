# Supabase Credentials
# These should be for your project
SUPABASE_URL="your_supabase_url_here"
SUPABASE_SERVICE_KEY="your_supabase_service_role_key_here"

# API Key for securing the communication between Supabase Edge Functions and this service
# Generate a long, random string for this
SERVICE_API_KEY="your_strong_secret_api_key_here"

# Port for the service to run on
PORT=8080